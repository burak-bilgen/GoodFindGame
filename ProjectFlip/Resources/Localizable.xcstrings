    "shop.offline": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your listings work while you are away. Sales still need your decision. No automatic sales, rent debt or offline cash grants."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen yokken ilanlarına ilgi gelebilir. Satış için yine senin kararın gerekir. Otomatik satış, biriken kira borcu veya çevrimdışı nakit ödülü yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Angebote bleiben während deiner Abwesenheit aktiv. Verkäufe brauchen weiterhin deine Entscheidung. Keine automatischen Verkäufe, Mietschulden oder Offline-Geldgeschenke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes annonces restent actives en ton absence. Les ventes nécessitent toujours ta décision. Aucune vente automatique, dette de loyer ou prime d'argent hors ligne."
          }
        }
      }
    },
