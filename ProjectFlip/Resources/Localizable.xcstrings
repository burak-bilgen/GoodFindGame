    "clients.arrivalHint": {
      "comment": "Active client request can bias one ordinary arrival slot every third eligible refresh. Uses public model IDs only; no instant stock or condition/price guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New arrivals sometimes favor models in your active request. Still check the price and condition; a suitable deal is not guaranteed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni gelenler zaman zaman aktif talebindeki modellere ağırlık verir. Fiyatı ve durumu yine incele; uygun alışveriş garantisi yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Angebote bevorzugen gelegentlich Modelle deines aktiven Auftrags. Prüfe trotzdem Preis und Zustand; ein passendes Geschäft ist nicht garantiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux arrivages favorisent parfois les modèles de ta demande active. Vérifie toujours le prix et l’état ; une bonne affaire n’est pas garantie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas llegadas favorecen a veces los modelos de tu encargo activo. Revisa el precio y el estado; no se garantiza una operación adecuada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi arrivi a volte favoriscono i modelli della richiesta attiva. Controlla comunque prezzo e condizioni; un buon affare non è garantito."
          }
        }
      }
    },
    "clients.firstSaleHint": {
      "comment": "First-sale market onboarding: ordinary market refreshes start after a completed sale; switching off the request filter reveals starter stock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete your first sale to start new market arrivals. Turn off the request filter to browse starter stock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ilanların gelmesi için ilk satışını tamamla. Başlangıç ürünlerini görmek için talep filtresini kapat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe deinen ersten Verkauf ab, damit neue Angebote eintreffen. Schalte den Auftragsfilter aus, um den Anfangsbestand zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ta première vente pour lancer les nouveaux arrivages. Désactive le filtre de demande pour voir le stock de départ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tu primera venta para que lleguen nuevos anuncios. Desactiva el filtro del encargo para ver el stock inicial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concludi la prima vendita per avviare i nuovi arrivi. Disattiva il filtro della richiesta per vedere gli articoli iniziali."
          }
        }
      }
    }
  },
