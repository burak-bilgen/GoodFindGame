          }
        }
      }
    },
    "clients.reportRequired": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full expert report required, with no unresolved faults. Payment replaces a normal sale; no extra cash bonus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giderilmemiş kusuru olmayan, tam uzman raporlu ürün gerekir. Ödeme normal satışın yerini alır; ek nakit bonusu yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständiger Expertenbericht ohne ungelöste Fehler erforderlich. Die Zahlung ersetzt einen normalen Verkauf; kein zusätzlicher Geldbonus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport d'expert complet exigé, sans défaut non réparé. Le paiement remplace une vente normale, sans bonus d'argent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un informe completo de experto y ningún fallo pendiente. El pago sustituye a una venta normal; no hay bonificación de dinero adicional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono una perizia completa e nessun guasto irrisolto. Il pagamento sostituisce una vendita normale: non c'è un premio in denaro aggiuntivo."
          }
        }
      }
    },
