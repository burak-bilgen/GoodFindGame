    "knowledge.clues.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for missing accessories first. Leaks, heating and motor problems need testing; a clean casing is not proof that it works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce eksik aksesuarlara bak. Kaçak, ısıtma ve motor sorunları test ister; temiz dış yüzey, çalıştığının kanıtı değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte zuerst auf fehlendes Zubehör. Lecks, Heizung und Motor brauchen Tests; ein sauberes Gehäuse beweist keine Funktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère d'abord les accessoires manquants. Les fuites, la chauffe et le moteur demandent des tests ; une coque propre ne prouve pas le bon fonctionnement."
          }
        }
      }
    },
    "knowledge.clues.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect the finish and upholstery. Loose joints and missing fixings can change whether a cheap piece is worth restoring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzeyi ve döşemeyi incele. Gevşek bağlantılar ve eksik montaj parçaları, ucuz bir eşyanın onarmaya değip değmediğini değiştirebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Oberfläche und Polster. Lockere Verbindungen und fehlende Befestigungen können entscheiden, ob sich ein günstiges Möbelstück restaurieren lässt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examine la finition et le revêtement. Des assemblages lâches ou des fixations manquantes peuvent changer l'intérêt d'une restauration."
          }
        }
      }
    },
    "knowledge.clues.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check zips, contact points, wheels and moving parts. A bag, bicycle and hand tool need different kinds of attention."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermuarları, temas yerlerini, tekerlekleri ve hareketli parçaları kontrol et. Çanta, bisiklet ve el aleti farklı dikkat ister."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Verschlüsse, Kontaktstellen, Rollen und bewegliche Teile. Tasche, Fahrrad und Handwerkzeug erfordern unterschiedliche Aufmerksamkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les fermetures, les points de contact, les roues et les pièces mobiles. Un sac, un vélo et un outil demandent des vérifications différentes."
          }
        }
      }
    },
    "knowledge.tools.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliance kit: leak tray, temperature probe and load tester. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev aleti seti: sızıntı tepsisi, sıcaklık probu ve yük test cihazı. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haushaltsgeräte-Set: Auffangwanne, Temperaturfühler und Lastprüfer. Dauerhaftes Kategoriewerkzeug; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit électroménager : bac de détection des fuites, sonde de température et testeur de charge. Outils permanents ; l'expertise reste nécessaire."
          }
        }
      }
    },
    "knowledge.tools.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furniture kit: joint gauges, inspection light and fastener tools. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilya seti: bağlantı ölçerler, inceleme lambası ve montaj aletleri. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möbel-Set: Verbindungslehren, Prüfleuchte und Befestigungswerkzeug. Dauerhaftes Kategoriewerkzeug; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit meubles : jauges d'assemblage, lampe d'inspection et outils de fixation. Outils permanents ; l'expertise reste nécessaire."
          }
        }
      }
    },
    "knowledge.tools.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyday-goods kit: material loupe, bearing gauges and mechanism tools. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündelik eşya seti: malzeme büyüteci, rulman ölçerler ve mekanizma aletleri. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltags-Set: Materiallupe, Lagerlehren und Mechanikwerkzeug. Dauerhaftes Kategoriewerkzeug; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit objets du quotidien : loupe, jauges de roulements et outils de mécanisme. Outils permanents ; l'expertise reste nécessaire."
          }
        }
      }
    },
    "living.audience.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
