    "listing.claimWarning": {
      "comment": "Listing/seller context: listing.claimWarning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seller claims may be incomplete. Inspection can reveal more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcının bilgisi eksik olabilir. İnceleme daha fazlasını ortaya çıkarabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkäuferangaben können unvollständig sein. Eine Prüfung kann mehr zeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indications du vendeur peuvent être incomplètes. Une inspection peut en révéler davantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descripción del vendedor puede estar incompleta. Una inspección puede revelar más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La descrizione del venditore può essere incompleta. Un'ispezione può rivelare altro."
          }
        }
      }
    },
    "listing.description": {
      "comment": "Listing/seller context: listing.description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the seller"
          }
        },
        "tr": {
          "stringUnit": {
