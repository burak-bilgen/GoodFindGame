    "clients.principle": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six buyers with connected stories. Hunt at your own pace; requests have no offline expiry. One accepted request at a time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirine bağlanan hikâyeleriyle altı alıcı. Kendi hızında ürün ara; taleplerin çevrimdışı süresi dolmaz. Aynı anda bir talep alabilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Käufer mit zusammenhängenden Geschichten. Suche in deinem Tempo; Aufträge verfallen offline nicht. Ein angenommener Auftrag gleichzeitig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six acheteurs et des histoires qui se suivent. Cherche à ton rythme ; les demandes n’expirent pas hors ligne. Une demande acceptée à la fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis compradores con historias conectadas. Busca a tu ritmo: los encargos no caducan mientras estás fuera. Solo uno aceptado a la vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei acquirenti con storie collegate. Cerca con i tuoi tempi: gli incarichi non scadono mentre sei via. Puoi accettarne uno alla volta."
          }
        }
      }
    },
    "clients.condition": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed condition: at least %lld / 100"
          }
        },
        "tr": {
          "stringUnit": {
