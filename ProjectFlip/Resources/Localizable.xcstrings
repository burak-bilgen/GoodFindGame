    "facts.legacyUnavailable": {
      "comment": "Legacy item without facts; explicitly does not invent historical measurements.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older item has no recorded measurements. Its saved condition and defect history are still available; measurements will appear on newly generated items."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eski ürün için ölçüm kaydı bulunmuyor. Kayıtlı kondisyon ve kusur geçmişi korunuyor; yeni oluşturulan ürünlerde ölçüm verileri bulunacak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen älteren Artikel wurden keine Messwerte gespeichert. Zustand und Fehlerhistorie sind weiterhin verfügbar. Neue Artikel enthalten Messwerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ancien objet ne possède pas de mesures enregistrées. Son état et son historique de défauts restent disponibles. Les nouveaux objets auront des mesures."
          }
        }
      }
    },
    "facts.regionGuide": {
      "comment": "Fictional collectible compatibility regions, unrelated to real country or user locale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This market uses Region A. Region B items may need compatible equipment; region-free items work across both."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pazarda A bölgesi kullanılır. B bölgesi ürünleri uyumlu ekipman gerektirebilir; bölge bağımsız ürünler her ikisinde de çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Markt nutzt Region A. Artikel aus Region B benötigen eventuell kompatible Geräte. Regionsfreie Artikel funktionieren in beiden Regionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce marché utilise la région A. Les objets de région B peuvent nécessiter du matériel compatible ; les objets multizones fonctionnent dans les deux régions."
          }
        }
      }
    },
    "facts.valueGuide": {
      "comment": "Clarifies economic meaning of evidence without exposing true value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements explain condition; they do not guarantee a selling price. Confirmed faults are also included in the defect summary and your estimate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçümler ürünün durumunu açıklar; satış fiyatı garantisi vermez. Doğrulanan kusurlar, kusur özetine ve tahmini değere de yansır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte erklären den Zustand, garantieren aber keinen Verkaufspreis. Bestätigte Fehler fließen auch in die Fehlerübersicht und Schätzung ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures expliquent l'état sans garantir un prix de vente. Les défauts confirmés figurent aussi dans le récapitulatif et dans l'estimation."
          }
        }
      }
    },
