        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That first find earned its place. Now I want the original box too; the little details tell its story."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk bulduğun ürün yerini hak etti. Şimdi orijinal kutusunu da istiyorum; küçük ayrıntılar onun hikâyesini anlatıyor."
          }
        }
      }
    },
    "client.rowan.story.2": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know what I collect now. Find an exceptional original Chapter example for the centerpiece. No invented rarity—just the right piece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık ne topladığımı biliyorsun. Koleksiyonun merkezi için çok temiz, özgün bir Chapter bul. Uydurma nadirlik değil, doğru parça."
          }
        }
      }
    },
    "client.jules.story.0": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My backup camera needs replacing. Find an inspected body with plenty of life left."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek fotoğraf makinemi değiştirmem gerekiyor. İncelenmiş, hâlâ iyi durumda bir gövde bul."
          }
        }
      }
    },
    "client.jules.story.1": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera worked out. This time I need clean optics; a good deal means nothing if the glass is wrong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine işimi gördü. Bu kez temiz optik lazım; camda sorun varsa iyi fiyatın anlamı kalmaz."
          }
        }
      }
    },
    "client.jules.story.2": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I trust your eye for equipment. Source a premium body for a demanding shoot, with a full report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipman konusundaki gözüne güveniyorum. Zorlu bir çekim için tam raporlu, üst düzey bir gövde bul."
          }
        }
      }
    },
    "client.rowan.ending": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You helped build a collection with a history. Collector’s confidant is now part of your story."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişi olan bir koleksiyon kurmama yardım ettin. Artık bir koleksiyoncunun sırdaşısın."
          }
        }
      }
    },
    "client.jules.ending": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You became the dealer I call before an important job. That is worth more than one good sale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli bir iş öncesinde aradığım satıcı oldun. Bunun değeri tek bir iyi satıştan büyük."
          }
        }
      }
    },
