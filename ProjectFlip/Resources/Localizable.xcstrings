          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Servicegebühr zählt. Der Wert des anvertrauten Artikels gehörte dir nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la rémunération compte. La valeur de l'objet confié ne t'a jamais appartenu."
