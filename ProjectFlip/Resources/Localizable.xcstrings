    "notifications.explanation": {
      "comment": "Local notifications: notifications.explanation. Positional placeholders are complete seller/item names, formatted game money and local expiry time. Never imply a real-world marketplace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to know when sellers reply and offers arrive? We only send alerts for events in your market."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcı yanıtlarından ve gelen tekliflerden haberdar olmak ister misin? Yalnızca pazarında gerçekleşen olayları bildiririz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du erfahren, wenn Verkäufer antworten oder Angebote eintreffen? Wir melden nur Ereignisse aus deinem Markt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie de savoir quand un vendeur répond ou qu’une offre arrive ? Les alertes concernent uniquement les événements de ton marché."
          }
        }
      }
    },
