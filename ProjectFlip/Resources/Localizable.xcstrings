{
  "sourceLanguage": "en",
  "strings": {
    "market.title": {
      "comment": "Primary marketplace tab and navigation title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Market"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marché"
          }
        }
      }
    },
    "market.empty": {
      "comment": "Empty market placeholder before listings are available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next discovery starts here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni keşiflerin burada başlıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier beginnt deine nächste Entdeckung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prochaine trouvaille commence ici."
          }
        }
      }
    },
    "messages.title": {
      "comment": "Negotiation conversations tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        }
      }
    },
    "messages.empty": {
      "comment": "Empty seller inbox: invite the player to investigate a listing; buyer negotiations remain on the live sale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a listing. Talk to the seller. One clue can change the deal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ilanı aç, satıcıyla konuş. Tek bir ipucu pazarlığı değiştirebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein Angebot und sprich mit dem Verkäufer. Ein Hinweis kann den ganzen Handel verändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une annonce et discute avec le vendeur. Un seul indice peut changer la donne."
          }
        }
      }
    },
    "inventory.title": {
      "comment": "Player-owned items tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventory"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envanter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventaire"
          }
        }
      }
    },
    "inventory.empty": {
      "comment": "Empty player inventory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your first item in the market."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk ürününü pazarda bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen ersten Artikel auf dem Markt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve ton premier objet sur le marché."
          }
        }
      }
    },
    "selling.title": {
      "comment": "Player resale listings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selling"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satışlar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventes"
          }
        }
      }
    },
    "selling.empty": {
      "comment": "Empty resale listing screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List an item from your inventory to start selling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satışa başlamak için envanterinden bir ürünü ilana koy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle einen Artikel aus deinem Inventar zum Verkauf ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets un objet de ton inventaire en vente pour commencer."
          }
        }
      }
    },
    "profile.title": {
      "comment": "Player profile tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        }
      }
    },
    "profile.intro": {
      "comment": "Trader profile introductory flavor copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deal tells a story. Make yours count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alışverişin bir hikâyesi var. Seninkini yaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Handel erzählt eine Geschichte. Mach deine besonders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque affaire a son histoire. À toi d’écrire la tienne."
          }
        }
      }
    },
    "market.heading": {
      "comment": "Market shell: market.heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the overlooked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözden kaçanı keşfet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke, was andere übersehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère ce que les autres ont manqué."
          }
        }
      }
    },
    "market.subtitle": {
      "comment": "Market shell: market.subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look closer. Ask questions. Make your move."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkatli bak. Soru sor. Fırsatı değerlendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau genauer hin. Frag nach. Entscheide selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe. Pose des questions. À toi de jouer."
          }
        }
      }
    },
    "wallet.cash": {
      "comment": "Market shell: wallet.cash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available cash"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir nakit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbares Geld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent disponible"
          }
        }
      }
    },
    "category.gaming": {
