    "repair.plan.uncertainty": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a value estimate, not a buyer’s offer. Undiscovered faults can still affect the sale. Repairs do not restore cosmetic condition or erase the inspection history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir değer tahmini, alıcı teklifi değil. Henüz bulunmamış arızalar satışı etkileyebilir. Tamir, dış görünüm puanını yenilemez veya inceleme geçmişini silmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Wertschätzung, kein Kaufangebot. Unentdeckte Defekte können den Verkauf weiterhin beeinflussen. Reparaturen verbessern den optischen Zustand nicht und löschen den Prüfverlauf nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une estimation de valeur, pas une offre d’achat. Des défauts non détectés peuvent encore affecter la vente. Les réparations ne restaurent pas l’état esthétique et n’effacent pas l’historique d’inspection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación de valor, no una oferta de compra. Los fallos aún no descubiertos pueden afectar a la venta. Las reparaciones no restauran el estado estético ni borran el historial de inspección."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una stima di valore, non un’offerta d’acquisto. Difetti non ancora scoperti possono influire sulla vendita. Le riparazioni non ripristinano le condizioni estetiche né cancellano lo storico delle ispezioni."
          }
        }
      }
    },
    "repair.plan.apply": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
