    "result.lesson.inspection": {
      "comment": "Settled-trade lesson. Name only discovered, unrepaired issues or actual charged services; do not disclose hidden faults or assert an unproven cause of the loss.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sale covered the purchase, but the inspection fee used up the margin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satış, alış fiyatını karşıladı ama inceleme ücreti kârı eritti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verkauf deckte den Kaufpreis, doch die Prüfgebühr hat die Marge aufgezehrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vente a couvert l'achat, mais les frais d'inspection ont absorbé la marge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La venta cubrió la compra, pero el coste de inspección consumió el margen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vendita ha coperto l'acquisto, ma il costo dell'ispezione ha consumato il margine."
          }
        }
      }
    },
