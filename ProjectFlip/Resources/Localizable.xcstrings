          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirtschaft aktualisiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économie mise à jour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Economía actualizada"
          }
