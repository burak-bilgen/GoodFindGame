    },
    "collections.intro": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the pieces that tell your story. Displays use your existing inventory space and tie up real trading capital. Worn pieces can still belong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hikâyeni anlatan parçaları sakla. Sergilenen ürünler envanterde yer tutar ve ticaret sermayeni bağlar. Aşınmış parçaların da yeri vardır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte Stücke, die deine Geschichte erzählen. Ausgestellte Artikel belegen Lagerplätze und binden echtes Handelskapital. Auch abgenutzte Stücke haben ihren Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les pièces qui racontent ton histoire. Les objets exposés occupent ton stock et immobilisent du capital. Même les pièces usées ont leur place."
          }
        }
      }
    },
