    "knowledge.explanation": {
      "comment": "Explains independent category progression and repeat-inspection protection; numbers are experience points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn by inspecting different items: +1 experience for your first self-inspection, +2 when an expert report arrives. Levels unlock at 3, 8 and 16 experience in each category. Rechecking the same item gives no extra experience."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı ürünleri inceleyerek öğren: ilk ücretsiz incelemende +1, uzman raporu geldiğinde +2 deneyim kazanırsın. Her kategoride 3, 8 ve 16 deneyimde seviye atlarsın. Aynı ürünü tekrar kontrol etmek deneyim kazandırmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne durch die Prüfung verschiedener Artikel: +1 Erfahrung bei der ersten Eigenprüfung, +2 beim Eingang eines Expertenberichts. Die Stufen werden je Kategorie bei 3, 8 und 16 Erfahrung freigeschaltet. Erneutes Prüfen desselben Artikels bringt keine zusätzliche Erfahrung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends en examinant différents objets : +1 point d'expérience à la première inspection personnelle, +2 à la réception d'un rapport d'expert. Chaque catégorie progresse à 3, 8 et 16 points. Réexaminer un même objet ne rapporte pas d'expérience supplémentaire."
          }
        }
      }
    },
