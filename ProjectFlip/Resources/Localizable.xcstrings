    "region.shared": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared market"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak pazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsamer Markt"
          }
        },
        "fr": {
          "stringUnit": {
