    "inventory.empty": {
      "comment": "Empty player inventory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your first item in the market."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk ürününü pazarda bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen ersten Artikel auf dem Markt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve ton premier objet sur le marché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu primer artículo en el mercado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova il tuo primo oggetto nel mercato."
          }
        }
      }
    },
    "selling.title": {
      "comment": "Player resale listings tab.",
      "extractionState": "manual",
      "localizations": {
