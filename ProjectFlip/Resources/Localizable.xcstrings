    "shop.open": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open my shop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dükkânımı aç"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meinen Laden eröffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir ma boutique"
          }
        }
      }
    },
    "shop.unlock": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete three trades to open your first shop. Your online selling continues as usual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk dükkânını açmak için üç al-sat tamamla. O zamana kadar çevrimiçi satışa devam edebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe drei Geschäfte ab, um deinen ersten Laden zu eröffnen. Dein Onlineverkauf läuft wie gewohnt weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclus trois transactions pour ouvrir ta première boutique. Tes ventes en ligne continuent normalement."
          }
        }
      }
    },
    "shop.style.bargains": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargain counter"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplı ürün tezgâhı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnäppchentheke"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coin des bonnes affaires"
          }
        }
      }
    },
    "shop.style.bargains.detail": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer at or below your inspected estimate. Faster interest, but bargain hunters and resellers protect their margins."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme tahmininin üzerinde fiyat isteme. İlgi daha hızlı gelir; pazarlıkçılar ve al-satçılar kendi kârını da düşünür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biete höchstens zum Wert deiner Prüfschätzung an. Interesse kommt schneller, doch Schnäppchenjäger und Wiederverkäufer achten auf ihre Marge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose un prix au plus égal à ton estimation après inspection. L'intérêt arrive plus vite, mais les chasseurs de bonnes affaires et les revendeurs protègent leur marge."
          }
        }
      }
    },
    "shop.style.tested": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tested & trusted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollü, güvenilir ürünler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüft & verlässlich"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testé et approuvé"
          }
        }
      }
    },
    "shop.style.tested.detail": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature fully inspected goods with no known unresolved faults. Pay for the evidence; attract cautious customers. Their budgets stay their own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekspertizli, bilinen arızası giderilmiş ürünleri sergile. İncelemeye yatırım yap; temkinli müşterilere hitap et. Bütçelerini yine onlar belirler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige vollständig geprüfte Ware ohne bekannte ungelöste Fehler. Bezahle für verlässliche Befunde und gewinne vorsichtige Kunden. Ihre Budgets bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose des objets entièrement inspectés, sans défaut connu non réparé. Finance les vérifications pour attirer des clients prudents. Leurs budgets restent inchangés."
          }
        }
