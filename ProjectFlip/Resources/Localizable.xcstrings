    "selling.quietHint": {
      "comment": "Optional sale-price review. Historical normal market sale of the same model only; never a forecast or automatic price change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offer is open right now. You can compare your estimate and past sales before changing the price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda açık teklif yok. Fiyatı değiştirmeden önce tahminini ve önceki satışlarını karşılaştırabilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell liegt kein offenes Angebot vor. Vergleiche deine Schätzung und frühere Verkäufe, bevor du den Preis änderst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune offre n’est ouverte pour le moment. Compare ton estimation et tes ventes passées avant de changer le prix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no hay ninguna oferta abierta. Puedes comparar tu estimación y tus ventas anteriores antes de cambiar el precio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non ci sono offerte aperte. Puoi confrontare la stima e le vendite passate prima di cambiare il prezzo."
          }
        }
      }
    },
