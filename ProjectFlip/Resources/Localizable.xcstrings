    "collections.lockedCapital": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept for your collection. Return it to trading before selling, servicing or supplying a client."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyonun için saklanıyor. Satmak, onarmak veya müşteriye vermek için önce ticarete geri al."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für deine Sammlung reserviert. Gib den Artikel zum Handel frei, bevor du ihn verkaufst, warten lässt oder einem Kunden lieferst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardé pour ta collection. Remets-le dans le stock avant de le vendre, de le faire réparer ou de le fournir à un client."
          }
        }
      }
    },
