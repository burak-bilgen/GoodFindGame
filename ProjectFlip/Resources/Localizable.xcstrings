          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen işlerin toplam masrafı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Arbeiten: Gesamtkosten"
          }
        },
        "fr": {
          "stringUnit": {
