    "client.noah.role": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community repair volunteer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamirat gönüllüsü"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helfer im Reparaturtreff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bénévole à l’atelier de réparation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voluntario del taller comunitario"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volontario del laboratorio di riparazione"
          }
        }
      }
    },
    "client.noah.story.0": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our neighborhood repair table needs reliable tools. Used is fine; faults that waste everybody’s afternoon are not."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahallenin tamir masasına güvenilir aletler lazım. İkinci el olur; herkesin öğleden sonrasını harcatan arızalar olmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Reparaturtreff braucht zuverlässiges Werkzeug. Gebraucht ist gut, aber Defekte sollen uns nicht den Nachmittag verderben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre atelier de quartier a besoin d’outils fiables. L’occasion convient ; les pannes qui gâchent l’après-midi, non."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa de reparaciones del barrio necesita herramientas fiables. De segunda mano, sí; fallos que nos hagan perder la tarde, no."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il banco riparazioni del quartiere ha bisogno di attrezzi affidabili. L’usato va bene, i guasti che fanno perdere il pomeriggio no."
          }
        }
      }
    },
    "client.noah.story.1": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tools are helping people again. For the community swap day, find something on wheels that is ready for regular use."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aletler yeniden insanlara fayda sağlıyor. Mahallenin takas günü için düzenli kullanıma hazır, tekerlekli bir şey bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Werkzeug hilft wieder Menschen. Finde für unseren Tauschtag etwas auf Rädern, das für den Alltag bereit ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils rendent à nouveau service. Pour la journée d’échange, trouve quelque chose à roues prêt à servir régulièrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas vuelven a ayudar a la gente. Para el día de intercambio, busca algo con ruedas listo para el uso habitual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli attrezzi aiutano di nuovo le persone. Per la giornata del baratto, cerca qualcosa con ruote pronto per l’uso quotidiano."
          }
        }
      }
    },
    "client.noah.story.2": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workshop has grown. I need a very clean tool setup I can lend out with confidence. Quality matters more than the label."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atölye büyüdü. Gönül rahatlığıyla ödünç verebileceğim, çok temiz bir alet takımı lazım. Kalite, etiketten önemli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werkstatt ist gewachsen. Ich brauche sehr gut erhaltenes Werkzeug, das ich bedenkenlos verleihen kann. Qualität zählt mehr als die Marke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’atelier a grandi. Il me faut des outils en très bon état que je puisse prêter en confiance. La qualité compte plus que l’étiquette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El taller ha crecido. Necesito herramientas en muy buen estado que pueda prestar con confianza. Importa la calidad, no la etiqueta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il laboratorio è cresciuto. Mi servono attrezzi in ottime condizioni da prestare con fiducia. Conta la qualità, non l’etichetta."
          }
        }
      }
    },
    "client.noah.ending": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You helped keep useful things in circulation. There is a place for you at the repair table whenever you visit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşe yarar eşyaların dolaşımda kalmasına yardım ettin. Ne zaman gelirsen tamir masasında sana yer var."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast geholfen, nützliche Dinge im Umlauf zu halten. Am Reparaturtisch ist immer ein Platz für dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as aidé à garder des objets utiles en circulation. Il y aura toujours une place pour toi à l’atelier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has ayudado a mantener cosas útiles en circulación. Siempre tendrás sitio en la mesa de reparaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aiutato a tenere in circolo oggetti utili. Al banco riparazioni ci sarà sempre un posto per te."
          }
        }
      }
    },
