    },
    "living.audience.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad audience with different budgets and needs."
          }
