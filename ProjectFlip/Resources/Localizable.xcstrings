{
  "sourceLanguage": "en",
  "strings": {
    "market.title": {
      "comment": "Primary marketplace tab and navigation title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Market"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazar"
          }
        }
      }
    },
    "market.empty": {
      "comment": "Empty market placeholder before listings are available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next discovery starts here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni keşiflerin burada başlıyor."
          }
        }
      }
    },
    "messages.title": {
      "comment": "Negotiation conversations tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar"
          }
        }
      }
    },
    "messages.empty": {
      "comment": "Empty conversation list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your conversations with sellers and buyers appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı ve satıcılarla konuşmaların burada görünür."
          }
        }
      }
    },
    "inventory.title": {
      "comment": "Player-owned items tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventory"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envanter"
          }
        }
      }
    },
    "inventory.empty": {
      "comment": "Empty player inventory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your first item in the market."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk ürününü pazarda bul."
          }
        }
      }
    },
    "selling.title": {
      "comment": "Player resale listings tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selling"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satışlar"
          }
        }
      }
    },
    "selling.empty": {
      "comment": "Empty resale listing screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List an item from your inventory to start selling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satışa başlamak için envanterinden bir ürünü ilana koy."
          }
        }
      }
    },
    "profile.title": {
      "comment": "Player profile tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        }
      }
    },
    "profile.intro": {
      "comment": "Trader profile introductory flavor copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deal tells a story. Make yours count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alışverişin bir hikâyesi var. Seninkini yaz."
          }
        }
      }
    },
    "market.heading": {
      "comment": "Market shell: market.heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the overlooked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözden kaçanı keşfet."
          }
        }
      }
    },
    "market.subtitle": {
      "comment": "Market shell: market.subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look closer. Ask questions. Make your move."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkatli bak. Soru sor. Fırsatı değerlendir."
          }
        }
      }
    },
    "wallet.cash": {
      "comment": "Market shell: wallet.cash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available cash"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir nakit"
          }
        }
      }
    },
    "category.gaming": {
      "comment": "Market shell: category.gaming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaming & electronics"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun ve elektronik"
          }
        }
      }
    },
    "market.newest": {
      "comment": "Market shell: market.newest.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest first"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en yeniler"
          }
        }
      }
    },
    "listing.title": {
      "comment": "Market shell: listing.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlan"
          }
        }
      }
    },
    "listing.hint.inspect": {
      "comment": "Market shell: listing.hint.inspect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condition is a claim. Look for clues."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondisyon bir iddiadır. İpuçlarını değerlendir."
          }
        }
      }
    },
    "save.error.title": {
      "comment": "Market shell: save.error.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your save needs attention"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt dosyası açılamadı"
          }
        }
      }
    },
    "save.error.load": {
      "comment": "Market shell: save.error.load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t load your game. Your existing save has been kept. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun yüklenemedi. Mevcut kaydın korundu. Tekrar dene."
          }
        }
      }
    },
    "action.retry": {
      "comment": "Market shell: action.retry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        }
      }
    },
