          "stringUnit": {
            "state": "translated",
            "value": "Bu rakamda anlaşırsak hızlıca alabilirim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn wir uns darauf einigen, können wir schnell abschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si on s'entend sur ce prix, je peux conclure rapidement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo cerrar rápido si acordamos este precio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso concludere subito se ci accordiamo su questa cifra."
          }
        }
      }
    },
    "buyer.offer.reseller": {
      "comment": "Living marketplace: actual saved state or uncertain public appraisal. No guaranteed buyer or hidden value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need margin for my own costs. There is not much room above this."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi giderlerim için pay bırakmam gerekiyor. Bu rakamın çok üstüne çıkamam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche Spielraum für meine eigenen Kosten. Viel mehr geht nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il me faut une marge pour mes propres frais. Je ne peux pas monter beaucoup plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesito margen para mis gastos. No puedo subir mucho más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi serve margine per le mie spese. Non posso salire molto di più."
          }
        }
      }
    },
    "buyer.offer.lowballer": {
      "comment": "Living marketplace: actual saved state or uncertain public appraisal. No guaranteed buyer or hidden value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would take it at this price. Otherwise I will keep looking."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rakama alırım. Olmazsa başka ilanlara bakacağım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Preis würde ich es nehmen. Sonst suche ich weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce prix, je le prends. Sinon, je continue à chercher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo compraría a este precio. Si no, seguiré buscando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo prenderei a questo prezzo. Altrimenti continuerò a cercare."
          }
        }
      }
    },
    "living.replyPending": {
      "comment": "Buyer counter reply is actually queued; the amount displayed is the existing prior offer, not a new response.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for buyer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcıdan yanıt bekleniyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf den Käufer"
          }
        },
        "fr": {
