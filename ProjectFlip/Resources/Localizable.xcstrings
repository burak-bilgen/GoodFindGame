    "listing.title": {
      "comment": "Market shell: listing.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
