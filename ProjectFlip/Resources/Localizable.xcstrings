    "client.leon.story.0": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am putting together a home recording corner. Find audio gear I can listen to properly; I do not need a flashy label."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde bir kayıt köşesi kuruyorum. Düzgün dinleyebileceğim ses ekipmanı bul; gösterişli etikete ihtiyacım yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich baue mir eine kleine Aufnahmeecke. Finde Audiotechnik zum vernünftigen Hören; eine schicke Marke brauche ich nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je monte un coin d’enregistrement à la maison. Trouve du matériel audio pour bien écouter ; pas besoin d’une marque voyante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy montando un rincón de grabación. Busca equipo de audio con el que pueda escuchar bien; no necesito una marca vistosa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto allestendo un angolo per registrare a casa. Cerca attrezzatura audio per ascoltare bene; non serve un marchio vistoso."
          }
        }
      }
    },
    "client.leon.story.1": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first sessions sounded good. Now the editing desk needs a dependable computer component or screen. Check the connections carefully."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kayıtlar iyi tınladı. Şimdi düzenleme masasına güvenilir bir bilgisayar parçası veya ekran lazım. Bağlantıları dikkatle kontrol et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten Aufnahmen klingen gut. Jetzt braucht der Schnittplatz einen zuverlässigen Computer oder Bildschirm. Prüfe die Anschlüsse genau."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les premières sessions sonnaient bien. Le bureau de montage a besoin d’un ordinateur ou d’un écran fiable. Vérifie soigneusement les connexions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las primeras sesiones sonaron bien. Ahora la mesa de edición necesita un ordenador o una pantalla fiables. Revisa las conexiones con cuidado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prime sessioni suonavano bene. Ora alla postazione di montaggio serve un computer o uno schermo affidabile. Controlla bene le connessioni."
          }
        }
      }
    },
    "client.leon.story.2": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A longer recording project is coming. Source a very clean upgrade for the studio desk, with a full report and no unresolved faults."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun bir kayıt projesi geliyor. Stüdyo masası için tam raporlu, çözülmemiş arızası olmayan, çok temiz bir yükseltme bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein längeres Aufnahmeprojekt steht an. Suche ein sehr gut erhaltenes Upgrade für den Studiotisch, mit vollständigem Bericht und ohne offene Mängel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet d’enregistrement plus long arrive. Trouve une amélioration en très bon état pour le studio, avec rapport complet et aucun défaut non résolu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acerca un proyecto de grabación largo. Busca una mejora en muy buen estado para el estudio, con informe completo y sin fallos pendientes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta arrivando un progetto di registrazione più lungo. Cerca un aggiornamento in ottime condizioni per lo studio, con perizia completa e nessun guasto irrisolto."
          }
        }
      }
    },
    "client.leon.ending": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The studio has a sound and a story now. Your finds helped make both; I will remember that before the next session."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stüdyonun artık bir sesi ve hikâyesi var. İkisinde de buluntularının payı var; sıradaki kayıt öncesi bunu hatırlayacağım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Studio hat jetzt einen Klang und eine Geschichte. Deine Funde haben beides mitgeprägt. Vor der nächsten Session denke ich daran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le studio a désormais un son et une histoire. Tes trouvailles ont contribué aux deux ; j’y penserai avant la prochaine session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estudio ya tiene sonido e historia. Tus hallazgos ayudaron a crear ambos; lo recordaré antes de la próxima sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo studio ora ha un suono e una storia. I tuoi ritrovamenti hanno contribuito a entrambi: lo ricorderò prima della prossima sessione."
          }
        }
      }
    },
