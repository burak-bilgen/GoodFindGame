      "comment": "Buyer holds an existing public offer; no private budget is revealed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am staying at this price. That is my final offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fiyatta kalıyorum. Son teklifim bu."
          }
        }
