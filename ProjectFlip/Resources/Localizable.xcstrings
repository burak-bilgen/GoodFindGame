    "clients.noModelsHint": {
      "comment": "Client model-filter empty state. Existing search/category/price filters also apply. No promise that matching stock will spawn or that a matching model has acceptable condition. Pausing a request is free and preserves progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other filters may narrow this search too. Clear them, check again as the market changes, or pause this request in Clients and try another."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer filtreler de bu aramayı daraltabilir. Filtreleri temizle, pazar değiştikçe tekrar bak ya da Müşteriler bölümünden bu isteği duraklatıp başka birini dene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Filter können diese Suche zusätzlich einschränken. Setze sie zurück, schau bei verändertem Angebot wieder nach oder pausiere den Auftrag unter Kunden und versuche einen anderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres filtres peuvent aussi limiter cette recherche. Efface-les, reviens quand le marché évolue ou mets cette demande en pause dans Clients pour en essayer une autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros filtros también pueden limitar esta búsqueda. Bórralos, vuelve cuando cambie el mercado o pausa este encargo en Clientes y prueba otro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche gli altri filtri possono limitare la ricerca. Rimuovili, ricontrolla quando cambia il mercato oppure sospendi la richiesta in Clienti e provane un’altra."
          }
        }
      }
    },
    "repair.plan.title": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan repairs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamir planı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparaturen planen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifier les réparations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificar reparaciones"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica le riparazioni"
          }
        }
      }
    },
    "repair.plan.explain": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which known faults to fix. Compare the total bill with the estimated value recovered before spending. You can leave other faults unrepaired and sell as-is."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinen arızalardan hangilerini yaptıracağını seç. Para harcamadan önce toplam masrafı tahmini değer artışıyla karşılaştır. Diğer arızaları onarmadan ürünü olduğu gibi satabilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welche bekannten Defekte du beheben möchtest. Vergleiche die Gesamtkosten mit dem geschätzten Wertzuwachs, bevor du Geld ausgibst. Du kannst andere Defekte belassen und den Artikel so verkaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les défauts connus à réparer. Compare le coût total au gain de valeur estimé avant de dépenser. Tu peux laisser les autres défauts et vendre l’objet en l’état."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué fallos conocidos reparar. Compara el coste total con el aumento de valor estimado antes de gastar. Puedes dejar otros fallos sin reparar y vender el artículo tal como está."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali difetti noti riparare. Confronta il costo totale con il recupero di valore stimato prima di spendere. Puoi lasciare altri difetti e vendere l’oggetto così com’è."
          }
        }
      }
    },
    "repair.plan.noWork": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
      "extractionState": "manual",
