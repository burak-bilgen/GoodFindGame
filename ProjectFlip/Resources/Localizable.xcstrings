    "trend.explanation": {
      "comment": "Explains bounded demand effects without promising a guaranteed sale price.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand shifts affect value estimates and new offers. Condition still matters, and existing offers keep their agreed price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talep değiştikçe değer tahminleri ve yeni teklifler de değişir. Ürünün durumu hâlâ önemlidir; verilmiş tekliflerin fiyatı korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachfrageänderungen beeinflussen Schätzwerte und neue Angebote. Der Zustand zählt weiterhin. Bereits vereinbarte Preise bleiben bestehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variations de la demande influencent les estimations et les nouvelles offres. L’état reste déterminant et les prix déjà convenus sont conservés."
          }
        }
      }
    },
    "trend.unlock": {
