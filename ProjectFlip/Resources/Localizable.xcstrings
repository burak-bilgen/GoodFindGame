    "repair.marginPositive": {
      "comment": "Repair decision: compares estimated value recovered minus service cost with selling as-is. This is not total trade profit or a guaranteed sale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The added value may cover the repair and leave more margin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer artışı onarımı karşılayıp kazanç payını artırabilir."
          }
        },
