      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy credits were rebased at 20:1 into canonical value. Cash, costs and outstanding quotes were converted together. Product valuations now use believable price bands. Your original save was backed up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski krediler 20:1 oranında temel değere dönüştürüldü. Nakit, maliyetler ve bekleyen teklifler birlikte çevrildi. Ürün değerleri artık gerçekçi fiyat aralıklarını kullanıyor. Önceki kaydın yedeklendi."
          }
        }
      }
    },
