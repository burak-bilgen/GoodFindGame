    "recovery.receipt": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service commission only. The consigned item's value was never yours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
