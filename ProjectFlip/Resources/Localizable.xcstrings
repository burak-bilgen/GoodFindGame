    "shop.stockHint": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from your active sale listings. A window spot changes the audience for future interest, not an offer already on the table."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif satış ilanlarından seç. Vitrin, bundan sonra gelecek ilgiyi etkiler; elindeki teklifi değiştirmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus deinen aktiven Verkaufsangeboten. Ein Schaufensterplatz ändert das Publikum für zukünftiges Interesse, nicht ein bereits vorliegendes Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis parmi tes annonces actives. Une place en vitrine change le public des futures visites, pas une offre déjà reçue."
