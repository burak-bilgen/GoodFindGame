    "save.restoreWarning": {
      "comment": "Release readiness: recovery, progression, privacy or support. Preserve format placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest changes may be lost. The current file will be kept separately before the last valid backup is restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son değişikliklerin kaybolabilir. Son sağlam yedek geri yüklenmeden önce mevcut dosya ayrıca saklanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzten Änderungen können verloren gehen. Die aktuelle Datei wird separat gesichert, bevor die letzte gültige Sicherung wiederhergestellt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes dernières modifications peuvent être perdues. Le fichier actuel sera conservé séparément avant la restauration de la dernière sauvegarde valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrías perder los últimos cambios. El archivo actual se conservará aparte antes de restaurar la última copia válida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti perdere le ultime modifiche. Il file attuale verrà conservato separatamente prima di ripristinare l'ultima copia valida."
          }
        }
      }
    },
    "privacy.title": {
      "comment": "Release readiness: recovery, progression, privacy or support. Preserve format placeholders.",
      "extractionState": "manual",
      "localizations": {
