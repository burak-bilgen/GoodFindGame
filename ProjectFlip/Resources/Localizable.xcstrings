    "trend.reason.creatorSpotlight": {
      "comment": "Reason for a positive model-specific trend; no real celebrity or brand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fictional creator’s showcase has collectors looking for this model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurgusal bir içerik üreticisi bu modeli tanıtınca koleksiyoncuların ilgisi arttı."
          }
        },
        "de": {
          "stringUnit": {
