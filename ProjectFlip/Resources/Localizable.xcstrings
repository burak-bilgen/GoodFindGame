    "listing.hint.inspect": {
      "comment": "Market shell: listing.hint.inspect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condition is a claim. Look for clues."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondisyon bir iddiadır. İpuçlarını değerlendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zustand ist nur eine Behauptung. Achte auf Hinweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état annoncé n’est qu’une promesse. Cherche les indices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado es una afirmación. Busca pistas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le condizioni sono una dichiarazione. Cerca indizi."
          }
        }
      }
    },
    "save.error.title": {
      "comment": "Market shell: save.error.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your save needs attention"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt dosyası açılamadı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Spielstand braucht Aufmerksamkeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème avec ta sauvegarde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida necesita atención"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio richiede attenzione"
          }
        }
      }
    },
    "save.error.load": {
      "comment": "Market shell: save.error.load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t load your game. Your existing save has been kept. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun yüklenemedi. Mevcut kaydın korundu. Tekrar dene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Spiel konnte nicht geladen werden. Dein bisheriger Spielstand wurde behalten. Versuch es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger ta partie. Ta sauvegarde a été conservée. Réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar la partida. Se ha conservado el archivo existente. Reintenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la partita. Il salvataggio esistente è stato conservato. Riprova."
          }
        }
      }
    },
    "action.retry": {
