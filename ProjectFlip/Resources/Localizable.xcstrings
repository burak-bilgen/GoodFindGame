    "competition.integrity": {
      "comment": "Competition V1: optional social play, isolated weekly economy and gameplay achievement copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline, device-based competition. Scores are checked locally; this is not a server-verified contest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı, cihaz tabanlı rekabet. Puanlar cihazda denetlenir; sonuçlar sunucu tarafından doğrulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Wettbewerb auf Gerätebasis. Punkte werden lokal geprüft; der Wettbewerb wird nicht serverseitig verifiziert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compétition hors ligne fondée sur l'appareil. Les scores sont contrôlés localement, sans validation par un serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Competición sin conexión, basada en el dispositivo. Las puntuaciones se comprueban localmente; no es un concurso verificado por un servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Competizione offline sul dispositivo. I punteggi vengono controllati localmente: non è una gara verificata da un server."
          }
        }
      }
    },
