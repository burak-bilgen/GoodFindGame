    "competition.scoreRules": {
      "comment": "Competition V1: optional social play, isolated weekly economy and gameplay achievement copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score v1: net realized profit relative to the starting bankroll, portfolio return, and a capped bonus for inspected profitable trades across different models. Losses reduce profit. Repeated models earn no extra quality bonus. Maximum: 1,000,000."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan v1: başlangıç sermayesine göre gerçekleşen net kâr, toplam yatırım getirisi ve farklı modellerdeki incelenmiş kârlı satışlar için sınırlı ek puan. Zararlar kârdan düşer. Aynı modeli tekrar satmak ek kalite puanı kazandırmaz. Üst sınır: 1.000.000."
          }
        }
      }
    },
