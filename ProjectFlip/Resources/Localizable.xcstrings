    },
    "knowledge.inspectionLimit": {
      "comment": "Limits on free inspection; no claim that unrevealed faults exist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-inspection can miss faults. New knowledge or tools let you recheck for free; an expert report is more thorough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz incelemede bazı kusurlar gözden kaçabilir. Bilgin arttığında veya araç aldığında ücretsiz tekrar bakabilirsin. Uzman raporu daha kapsamlıdır."
          }
        }
      }
    },
    "facts.title": {
      "comment": "Owned-item measurements and category evidence screen title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection findings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme bulguları"
          }
        }
      }
    },
    "facts.explanation": {
      "comment": "Explains unknown measurements and ways to reveal them without claiming a fault exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These findings belong to this physical item. A locked field has not been checked; it does not mean the item passed. Improve your category knowledge and tools, then recheck, or order an expert report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bulgular elindeki ürüne aittir. Kilitli alan henüz kontrol edilmemiştir; ürünün sorunsuz olduğu anlamına gelmez. Kategori bilgini ve araçlarını geliştirip tekrar incele veya uzman raporu iste."
          }
        }
      }
    },
    "facts.notChecked": {
      "comment": "Unknown fact value, never a healthy result.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol edilmedi"
          }
        }
      }
    },
    "facts.requiresBasic": {
      "comment": "Requirement for visible item evidence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revealed by a free self-inspection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz incelemeyle öğrenilir."
          }
        }
      }
    },
    "facts.requiresSkills": {
      "comment": "One argument: localized expertise rank. Turkish rank precedes düzeyinde.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires %@ knowledge and the category kit, or an expert report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ düzeyinde kategori bilgisi ve inceleme seti ya da uzman raporu gerekir."
          }
        }
      }
    },
    "facts.legacyUnavailable": {
      "comment": "Legacy item without facts; explicitly does not invent historical measurements.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older item has no recorded measurements. Its saved condition and defect history are still available; measurements will appear on newly generated items."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eski ürün için ölçüm kaydı bulunmuyor. Kayıtlı kondisyon ve kusur geçmişi korunuyor; yeni oluşturulan ürünlerde ölçüm verileri bulunacak."
          }
        }
      }
    },
    "facts.regionGuide": {
      "comment": "Fictional collectible compatibility regions, unrelated to real country or user locale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This market uses Region A. Region B items may need compatible equipment; region-free items work across both."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pazarda A bölgesi kullanılır. B bölgesi ürünleri uyumlu ekipman gerektirebilir; bölge bağımsız ürünler her ikisinde de çalışır."
          }
        }
      }
    },
    "facts.valueGuide": {
      "comment": "Clarifies economic meaning of evidence without exposing true value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements explain condition; they do not guarantee a selling price. Confirmed faults are also included in the defect summary and your estimate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçümler ürünün durumunu açıklar; satış fiyatı garantisi vermez. Doğrulanan kusurlar, kusur özetine ve tahmini değere de yansır."
          }
        }
      }
    },
