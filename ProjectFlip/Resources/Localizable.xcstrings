    "collection.focal.story": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wide scenes, everyday stories, intimate portraits. Three different pieces of glass; one way of seeing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniş manzaralar, günlük hikâyeler, yakın portreler. Üç farklı cam; bir bakış açısı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weite Landschaften, Alltagsszenen, intime Porträts. Drei verschiedene Optiken, ein Blick auf die Welt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grands paysages, récits du quotidien, portraits intimes. Trois optiques différentes, un regard sur le monde."
          }
        }
      }
    },
