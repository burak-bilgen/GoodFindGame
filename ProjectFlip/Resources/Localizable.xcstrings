    },
    "knowledge.clues.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for missing accessories first. Leaks, heating and motor problems need testing; a clean casing is not proof that it works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce eksik aksesuarlara bak. Kaçak, ısıtma ve motor sorunları test ister; temiz dış yüzey, çalıştığının kanıtı değildir."
          }
        }
      }
    },
    "knowledge.clues.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect the finish and upholstery. Loose joints and missing fixings can change whether a cheap piece is worth restoring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzeyi ve döşemeyi incele. Gevşek bağlantılar ve eksik montaj parçaları, ucuz bir eşyanın onarmaya değip değmediğini değiştirebilir."
          }
        }
      }
    },
    "knowledge.clues.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check zips, contact points, wheels and moving parts. A bag, bicycle and hand tool need different kinds of attention."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermuarları, temas yerlerini, tekerlekleri ve hareketli parçaları kontrol et. Çanta, bisiklet ve el aleti farklı dikkat ister."
          }
        }
      }
    },
    "knowledge.tools.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliance kit: leak tray, temperature probe and load tester. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev aleti seti: sızıntı tepsisi, sıcaklık probu ve yük test cihazı. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        }
      }
    },
    "knowledge.tools.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furniture kit: joint gauges, inspection light and fastener tools. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilya seti: bağlantı ölçerler, inceleme lambası ve montaj aletleri. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        }
      }
    },
    "knowledge.tools.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyday-goods kit: material loupe, bearing gauges and mechanism tools. Permanent category tools; expertise is still needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündelik eşya seti: malzeme büyüteci, rulman ölçerler ve mekanizma aletleri. Bu kategoride kalıcıdır; yine de uzmanlık gerekir."
          }
        }
      }
    },
    "living.audience.home": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practical household buyers; function and total cost matter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlev ve toplam maliyeti önemseyen ev kullanıcıları."
          }
        }
      }
    },
    "living.audience.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furniture buyers look at condition and value; interest is not guaranteed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilya alıcısı duruma ve değere bakar; ilgi garanti değildir."
          }
        }
      }
    },
    "living.audience.everyday": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad audience with different budgets and needs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı ihtiyaçları ve bütçeleri olan geniş bir kitle."
          }
        }
      }
    },
    "listing.voice.casual.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making some room at home. I can send a closer photo if there is something you want to see."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde yer açıyorum. Merak ettiğin bir yer varsa yakından fotoğrafını da gönderebilirim."
          }
        }
      }
    },
    "listing.voice.casual.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has been sitting in the spare room. I would rather someone used it than keep moving it out of the way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş odada durup duruyor. Sürekli yerini değiştireceğime kullanacak birine gitsin istedim."
          }
        }
      }
    },
    "listing.voice.casual.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are changing things around at home, so this is going. Have a look and ask before deciding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde biraz değişiklik yapıyoruz, bu da satılacaklar arasında. Karar vermeden bak, aklına takılanı sor."
          }
        }
      }
    },
    "listing.voice.clueless.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helping a relative clear some things out. I have not checked every detail, so please ask rather than assume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yakınımın eşyalarını elden çıkarmasına yardım ediyorum. Her ayrıntısını kontrol etmedim; varsaymak yerine sor lütfen."
          }
        }
      }
    },
    "listing.voice.clueless.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know what it is, but I am not the person to ask about the technical bits. Photos are of the actual item."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olduğunu biliyorum ama teknik ayrıntılarından pek anlamam. Fotoğraflar satılan eşyanın kendisine ait."
          }
        }
      }
    },
    "listing.voice.clueless.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found this while sorting the house. I cannot give a detailed condition report; the price reflects that uncertainty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evi toparlarken çıktı. Ayrıntılı durum raporu verecek bilgim yok; fiyatı da o belirsizliği düşünerek koydum."
          }
        }
      }
    },
    "listing.voice.urgent.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving this week. Collection soon matters more to me than a long back-and-forth over the last few notes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta taşınıyorum. Son birkaç kuruş için günlerce yazışmaktansa çabuk alınması daha önemli."
          }
        }
      }
    },
    "listing.voice.urgent.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need the space back. If you are seriously interested, send a clear offer and we can sort it out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapladığı yere ihtiyacım var. Ciddi düşünüyorsan net bir teklif gönder, konuşalım."
          }
        }
      }
    },
    "listing.voice.urgent.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the last things left to clear. I would like a straightforward sale, not days of reserved promises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elden çıkarılacak son eşyalardan biri. Günlerce ayırmamı istemektense net bir satış olsun istiyorum."
          }
        }
      }
    },
    "listing.voice.professional.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available from my current stock. Please specify which detail you want checked; I prefer clear questions to guesses."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut stoktan satılıktır. Hangi ayrıntıyı kontrol etmemi istediğini belirt; tahmin yürütmektense net sorularla ilerleyelim."
          }
        }
      }
    },
    "listing.voice.professional.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The asking price is for this exact example. Condition, included parts and a clear agreement matter more than the headline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlan fiyatı bu ürün içindir. Başlıktan çok durumu, yanında verilen parçalar ve net bir anlaşma önemlidir."
          }
        }
      }
    },
    "listing.voice.professional.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I handle these regularly. Ask about the condition before offering so we do not talk past each other."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tür eşyalarla düzenli ilgileniyorum. Tekliften önce durumunu sorarsan birbirimizi yanlış anlamayız."
          }
        }
      }
    },
    "listing.voice.stubborn.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am in no hurry. If the price does not work for you, that is fine, but please do not open with half of it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelem yok. Fiyat sana uymayabilir, sorun değil; ama yarısını teklif ederek başlamayalım lütfen."
          }
        }
      }
    },
    "listing.voice.stubborn.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed at the price I am willing to discuss. Comparing it with an unseen bargain elsewhere will not help much."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmaya değer bulduğum fiyattan koydum. Başka yerde görmediğimiz bir fırsatla kıyaslamak pek yardımcı olmuyor."
          }
        }
      }
    },
    "listing.voice.stubborn.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still available. Sensible questions are welcome; I am not looking to get rid of it at any price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ satılık. Mantıklı sorulara açığım; yeter ki gitsin diye her fiyata bırakmayı düşünmüyorum."
          }
        }
      }
    },
    "listing.voice.friendly.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would like this to go to someone who has a use for it. Happy to talk through the details."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşine yarayacak birine gitsin istiyorum. Ayrıntılarını birlikte konuşabiliriz."
          }
        }
      }
    },
    "listing.voice.friendly.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rush to decide from one photo. Tell me what you need to know and I will answer what I can."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek fotoğraftan hemen karar vermek zorunda değilsin. Merak ettiğini söyle, bildiğim kadarıyla cevaplayayım."
          }
        }
      }
    },
    "listing.voice.friendly.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit of a clear-out, not a shop. Be fair with me and I will be fair with you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dükkân değil, evden birkaç eşya satıyorum. Karşılıklı makul davranırsak anlaşırız."
          }
        }
      }
    },
    "listing.voice.manipulative.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks the part. There has been interest, so I would rather keep this quick than go through a long checklist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duruşu yerinde. İlgilenenler var; uzun kontrol listelerine girmeden hızlıca halletsek iyi olur."
          }
        }
      }
    },
    "listing.voice.manipulative.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priced to get your attention. The photos should tell you enough for a first offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat çeksin diye bu fiyattan koydum. İlk teklif için fotoğraflar yeterince fikir veriyordur."
          }
        }
      }
    },
    "listing.voice.manipulative.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good-looking find for somebody. I cannot hold it while every tiny mark gets discussed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinin hoşuna gidecek bir parça. Her küçük izi konuşurken günlerce ayıramam."
          }
        }
      }
    },
    "listing.voice.collector.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have a reason for keeping things, and a reason for letting them go. This one is ready for a new owner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşyaları saklamamın da elden çıkarmamın da bir nedeni var. Bu artık yeni sahibine gitmeye hazır."
          }
        }
      }
    },
    "listing.voice.collector.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small details matter to me. Ask about what is actually here; I will not invent a story to make it sound rare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük ayrıntıları önemserim. Eşyanın kendisini sor; nadirmiş gibi göstermek için hikâye uydurmam."
          }
        }
      }
    },
    "listing.voice.collector.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More interested in a thoughtful buyer than the fastest message. We can talk about the details before the price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En hızlı mesajdan çok ne aldığını bilen biri ilgimi çeker. Fiyattan önce ayrıntıları konuşabiliriz."
          }
        }
      }
    },
