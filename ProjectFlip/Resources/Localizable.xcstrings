    "shop.capitalChoice": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend on more space or keep the cash for your next find. Expansion does not raise buyer budgets or guarantee profit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanı büyüt ya da nakdi yeni bir fırsat için ayır. Büyümek alıcının bütçesini artırmaz, kârı garanti etmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Investiere in mehr Platz oder behalte das Geld für den nächsten Fund. Ein Ausbau erhöht keine Käuferbudgets und garantiert keinen Gewinn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandis la boutique ou garde l'argent pour ta prochaine trouvaille. L'agrandissement n'augmente pas les budgets des acheteurs et ne garantit aucun bénéfice."
          }
        }
      }
    },
