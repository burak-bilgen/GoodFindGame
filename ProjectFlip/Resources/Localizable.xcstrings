    "career.principle": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust opens doors. It does not raise your prices or guarantee profits. A documented loss still counts as experience."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven kapıları açar. Fiyatlarını yükseltmez, kârı garantilemez. Kayıtlı bir zarar da deneyimdir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauen öffnet Türen. Es erhöht weder Preise noch garantiert es Gewinne. Auch ein dokumentierter Verlust zählt als Erfahrung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confiance ouvre des portes. Elle n'augmente pas tes prix et ne garantit aucun bénéfice. Une perte documentée compte aussi comme expérience."
          }
        }
      }
    },
    "career.requirement.0": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a small bankroll and learn to read ordinary listings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir sermayeyle başla, sıradan ilanları okumayı öğren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit kleinem Kapital und lerne, gewöhnliche Angebote einzuschätzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec un petit capital et apprends à évaluer les annonces ordinaires."
          }
        }
      }
    },
    "career.requirement.1": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete 3 inspected trades, or supply your first recurring client."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenmiş 3 ürün sat ya da ilk devamlı müşterinin talebini karşıla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe 3 Geschäfte mit geprüften Artikeln ab oder beliefere deinen ersten Stammkunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclus 3 transactions avec des objets inspectés, ou livre ton premier client régulier."
          }
        }
      }
    },
    "career.requirement.2": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete 8 inspected trades and reach rank 2 in a category."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenmiş 8 ürün sat ve bir kategoride 2. seviyeye ulaş."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe 8 Geschäfte mit geprüften Artikeln ab und erreiche Stufe 2 in einer Kategorie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclus 8 transactions avec des objets inspectés et atteins le niveau 2 dans une catégorie."
          }
        }
      }
    },
    "career.requirement.3": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete 16 inspected trades, reach rank 3, and fulfill 3 client requests. Or complete 24 inspected trades at rank 3."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenmiş 16 ürün sat, 3. seviyeye ulaş ve 3 müşteri talebini karşıla. Alternatif olarak 3. seviyede incelenmiş 24 ürün sat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe 16 Geschäfte mit geprüften Artikeln ab, erreiche Stufe 3 und erfülle 3 Kundenaufträge. Alternativ: 24 geprüfte Geschäfte bei Stufe 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclus 16 transactions avec des objets inspectés, atteins le niveau 3 et remplis 3 demandes de clients. Ou conclus 24 transactions inspectées au niveau 3."
          }
        }
      }
    },
    "career.access.0": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
