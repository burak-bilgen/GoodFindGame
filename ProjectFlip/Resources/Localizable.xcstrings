    "selling.repriceOfferWarning": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the price ends the current buyer negotiation, cancels any pending reply and starts a new buyer search."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatı değiştirmek mevcut alıcı pazarlığını bitirir, beklenen yanıtı iptal eder ve yeni bir alıcı araması başlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Preisänderung beendet die laufende Käuferverhandlung, bricht eine ausstehende Antwort ab und startet eine neue Käufersuche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le prix met fin à la négociation en cours, annule toute réponse attendue et lance une nouvelle recherche d’acheteurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el precio termina la negociación actual, cancela cualquier respuesta pendiente e inicia una nueva búsqueda de compradores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare il prezzo termina la trattativa attuale, annulla le risposte in attesa e avvia una nuova ricerca di acquirenti."
          }
        }
      }
    },
    "selling.repriceSearch": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new price starts a new buyer search. An offer is not guaranteed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni fiyatla alıcı araması yeniden başlar. Teklif geleceği garanti değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem neuen Preis beginnt eine neue Käufersuche. Ein Angebot ist nicht garantiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau prix lance une nouvelle recherche d’acheteurs, sans garantie d’offre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo precio inicia otra búsqueda de compradores. No se garantiza una oferta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo prezzo avvia un’altra ricerca di acquirenti. Non è garantita un’offerta."
          }
        }
      }
    },
    "selling.repriceExpiry": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listing end time does not reset. Views and favorites already earned remain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlanın bitiş süresi sıfırlanmaz. Mevcut görüntülenmeler ve favoriler korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ablaufzeit des Angebots wird nicht zurückgesetzt. Bisherige Aufrufe und Merkliste-Einträge bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de fin de l’annonce ne change pas. Les vues et les favoris déjà obtenus restent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de cierre del anuncio no cambia. Se conservan las visitas y los favoritos acumulados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza dell’annuncio non cambia. Le visualizzazioni e i preferiti già ottenuti restano."
          }
        }
      }
    },
    "player.changedPrice": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
      "extractionState": "manual",
