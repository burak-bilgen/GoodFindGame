    "competition.finishHint": {
      "comment": "Competition V1: optional social play, isolated weekly economy and gameplay achievement copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizing ends your trading for this week. Unsold items earn no score. You can submit your result while this week is still open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonucunu kesinleştirince bu haftaki al-satın sona erer. Satılmayan ürünler puan kazandırmaz. Hafta bitmeden sonucunu sıralamaya gönderebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Abschluss endet dein Handel für diese Woche. Unverkaufte Artikel bringen keine Punkte. Du kannst dein Ergebnis bis zum Ende dieser Woche einreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valider met fin à tes échanges pour cette semaine. Les objets invendus ne rapportent aucun point. Tu peux envoyer ton résultat tant que la semaine est en cours."
          }
        }
      }
    },
