    "result.lesson.costs": {
      "comment": "Post-trade learning; shown only when supported by settled amounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sale covered the purchase, but inspection and repair costs used up the margin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satış, alış fiyatını karşıladı ama inceleme ve onarım masrafları kârı eritti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verkauf deckte den Kaufpreis, doch Prüfung und Reparatur haben die Marge aufgezehrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vente a couvert l'achat, mais l'inspection et la réparation ont absorbé la marge."
          }
        }
      }
    },
    "result.lesson.even": {
      "comment": "Post-trade learning; shown only when supported by settled amounts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You got your money back. A lower buying price could have left a margin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcadığını geri aldın. Daha düşük bir alış fiyatı kâr bırakabilirdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deinen Einsatz zurück. Ein niedrigerer Einkaufspreis hätte Raum für Gewinn gelassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as récupéré ta mise. Un prix d'achat plus bas aurait pu laisser une marge."
          }
        }
      }
    },
    "result.lesson.fault": {
      "comment": "Settled-trade lesson. Name only discovered, unrepaired issues or actual charged services; do not disclose hidden faults or assert an unproven cause of the loss.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item sold with known faults. On the next deal, weigh the repair bill against the value it might recover."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürünü bilinen sorunlarıyla sattın. Bir sonraki fırsatta onarım ücretini, kazandırabileceği değerle karşılaştır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Artikel wurde mit bekannten Fehlern verkauft. Wäge beim nächsten Mal die Reparaturkosten gegen den möglichen Wertzuwachs ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objet a été vendu avec ses défauts connus. La prochaine fois, compare le coût de réparation à la valeur qu'elle pourrait récupérer."
          }
        }
      }
    },
    "result.lesson.price": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sale didn’t cover what you put in. Leave more room between your buying price and expected resale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satışın toplam harcamanı karşılamadı. Bir dahaki sefere alış fiyatıyla beklenen satış arasında daha çok pay bırak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erlös hat deinen Einsatz nicht gedeckt. Lass mehr Abstand zwischen Einkaufspreis und erwartetem Verkaufspreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vente n'a pas couvert ta mise. Prévois plus d'écart entre le prix d'achat et le prix de revente espéré."
          }
        }
      }
    },
    "result.lesson.win": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
