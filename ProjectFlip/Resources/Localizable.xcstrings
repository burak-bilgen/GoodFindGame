    "seller.voice.casual": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’m making room for something new.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yenisini alacağım, bunu elden çıkarıyorum.”"
          }
        }
      }
    },
    "seller.voice.clueless": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“It belonged to someone in the family. I’m no expert.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Aileden birinin ürünü. Pek anladığım bir şey değil.”"
          }
        }
      }
    },
    "seller.voice.collector": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’ve looked after it. I’d rather wait than give it away.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Özenle sakladım. Yok pahasına vereceğime beklerim.”"
          }
        }
      }
    },
    "seller.voice.friendly": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ask away. I’d like it to go to someone who’ll use it.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Aklına takılanı sor. Kullanacak birine gitsin isterim.”"
          }
        }
      }
    },
    "seller.voice.manipulative": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Plenty of life left in it. Let’s keep this quick.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Daha çok iş görür. Uzatmadan anlaşalım.”"
          }
        }
      }
    },
    "seller.voice.professional": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I know this model well. Happy to answer specific questions.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bu modeli iyi bilirim. Merak ettiğini sorabilirsin.”"
          }
        }
      }
    },
    "seller.voice.stubborn": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’ve priced it fairly. Please be realistic.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Fiyatı uygun yazdım zaten. Ciddi teklifler lütfen.”"
          }
        }
      }
    },
    "seller.voice.urgent": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’d like this gone today. Make me an offer.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bugün satılsın istiyorum. Teklifini söyle.”"
          }
        }
      }
    },
    "selling.follow": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
