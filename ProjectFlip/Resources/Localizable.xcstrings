    "seller.voice.casual": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’m making room for something new.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yenisini alacağım, bunu elden çıkarıyorum.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ich mache Platz für etwas Neues.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Je fais de la place pour du neuf. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Estoy haciendo sitio para algo nuevo»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sto facendo spazio per qualcosa di nuovo.»"
          }
        }
      }
    },
    "seller.voice.clueless": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“It belonged to someone in the family. I’m no expert.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Aileden birinin ürünü. Pek anladığım bir şey değil.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Es gehörte jemandem aus der Familie. Ich kenne mich damit nicht aus.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« C'était à quelqu'un de la famille. Je ne m'y connais pas. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Era de alguien de la familia. No soy experto»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Era di qualcuno in famiglia. Non sono un esperto.»"
          }
        }
      }
    },
    "seller.voice.collector": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’ve looked after it. I’d rather wait than give it away.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Özenle sakladım. Yok pahasına vereceğime beklerim.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ich habe gut darauf aufgepasst. Lieber warte ich, als es zu verschenken.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« J'en ai pris soin. Je préfère attendre plutôt que le brader. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Lo he cuidado. Prefiero esperar a malvenderlo»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«L'ho tenuto con cura. Preferisco aspettare che svenderlo.»"
          }
        }
      }
    },
    "seller.voice.friendly": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ask away. I’d like it to go to someone who’ll use it.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Aklına takılanı sor. Kullanacak birine gitsin isterim.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Frag ruhig. Schön wäre, wenn es wieder genutzt wird.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« N'hésite pas à poser des questions. J'aimerais qu'il serve à quelqu'un. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pregunta lo que quieras. Quiero que lo tenga alguien que lo use»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Chiedi pure. Vorrei darlo a qualcuno che lo userà.»"
          }
        }
      }
    },
    "seller.voice.manipulative": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Plenty of life left in it. Let’s keep this quick.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Daha çok iş görür. Uzatmadan anlaşalım.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das hält noch lange. Machen wir es kurz.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Il a encore de beaux jours devant lui. Faisons vite. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Aún le queda mucha vida. Hagámoslo rápido»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ha ancora molta vita davanti. Facciamo in fretta.»"
          }
        }
      }
    },
    "seller.voice.professional": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I know this model well. Happy to answer specific questions.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bu modeli iyi bilirim. Merak ettiğini sorabilirsin.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ich kenne dieses Modell gut. Konkrete Fragen beantworte ich gern.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Je connais bien ce modèle. Je réponds volontiers aux questions précises. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Conozco bien este modelo. Respondo a preguntas concretas»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Conosco bene questo modello. Rispondo volentieri a domande specifiche.»"
          }
        }
      }
    },
    "seller.voice.stubborn": {
      "comment": "Core trade gameplay copy. Preserve conversational tone and economic uncertainty; no guaranteed deals.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’ve priced it fairly. Please be realistic.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Fiyatı uygun yazdım zaten. Ciddi teklifler lütfen.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Der Preis ist fair. Bitte bleib realistisch.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Le prix est juste. Merci de rester réaliste. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«El precio es justo. Sé realista, por favor»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
