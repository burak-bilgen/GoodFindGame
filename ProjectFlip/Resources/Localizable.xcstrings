            "state": "translated",
            "value": "En attente de l'acheteur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al comprador"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa dell'acquirente"
          }
        }
      }
    },
    "living.previousOffer": {
