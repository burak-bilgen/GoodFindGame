    "recovery.principle": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad trades have a cost. Keep your knowledge and career; recover working capital through a small service job or accept a clear liquidation loss."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötü ticaretin bedeli olur. Bilgini ve kariyerini koru; küçük bir hizmet işiyle sermaye topla ya da açık bir tasfiye zararını kabul et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Geschäfte haben ihren Preis. Wissen und Karriere bleiben erhalten. Gewinne Betriebskapital durch einen kleinen Serviceauftrag zurück oder nimm einen klaren Verlust beim Abverkauf in Kauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises affaires ont un coût. Tu conserves tes connaissances et ta carrière. Récupère du capital par un petit service ou accepte une perte claire lors d'une liquidation."
          }
        }
      }
    },
    "recovery.consigned": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigned goods — not your stock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emanet ürün — sana ait değil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvertraute Ware — nicht dein Bestand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objet confié — il ne t'appartient pas"
          }
        }
      }
    },
    "recovery.task": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local dealer needs a basic exterior check on a supplied controller. Inspect and return it for a modest service fee. It cannot be sold or collected and earns no expertise or trust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir satıcı, verdiği kumandanın dış kontrolünü istiyor. İncele ve küçük bir hizmet ücreti karşılığında geri ver. Ürün satılamaz, koleksiyona eklenemez; uzmanlık veya güven kazandırmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Händler braucht eine einfache äußere Prüfung eines bereitgestellten Controllers. Prüfe ihn und gib ihn gegen eine kleine Gebühr zurück. Er kann weder verkauft noch gesammelt werden und bringt weder Wissen noch Vertrauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marchand te confie une manette pour une vérification extérieure simple. Inspecte-la et rends-la contre une petite rémunération. Elle ne peut être ni vendue ni collectionnée et ne rapporte ni expertise ni confiance."
          }
        }
      }
    },
    "recovery.finish": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return the consigned item"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emanet ürünü geri ver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvertrauten Artikel zurückgeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre l'objet confié"
          }
        }
      }
    },
    "recovery.returnFor": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return for a %@ service fee"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hizmet ücreti karşılığında geri ver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Servicegebühr von %@ zurückgeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre contre une rémunération de %@"
          }
        }
      }
    },
    "recovery.limit": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only below %@ cash, with no trading stock or deliveries left. Fees stop at that cash floor. Your displayed collection can stay yours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca nakit %@ altındayken, ticaret stoku veya teslimat kalmamışsa kullanılabilir. Nakit bu sınıra ulaşınca ücretler durur. Koleksiyon parçaların sende kalabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur unter %@ Bargeld, ohne übrigen Handelsbestand oder Lieferungen. Bei dieser Bargeldgrenze enden die Gebühren. Deine ausgestellte Sammlung kannst du behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement sous %@, sans stock à vendre ni livraison en cours. Les rémunérations s'arrêtent à ce seuil. Tu peux garder ta collection exposée."
          }
        }
      }
    },
    "recovery.begin": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the service job"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet işini al"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviceauftrag annehmen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter le travail"
          }
        }
      }
    },
    "recovery.notEligible": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery job is needed now. Resolve incoming or held trading stock first. Active listings can be withdrawn from Selling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kurtarma işi gerekmiyor. Önce gelecek ürünleri veya ticaret stokunu değerlendir. Aktif ilanları Satışlar ekranından geri çekebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit ist kein Überbrückungsauftrag nötig. Kümmere dich zuerst um Lieferungen oder vorhandene Handelsware. Aktive Angebote kannst du unter Verkauf zurückziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas besoin de ce travail pour l'instant. Occupe-toi d'abord des livraisons ou du stock restant. Tu peux retirer les annonces actives depuis Ventes."
          }
        }
      }
    },
    "recovery.liquidation": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear held stock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldeki stoku tasfiye et"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestand abverkaufen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquider le stock"
          }
        }
      }
    },
    "recovery.liquidationWarning": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wholesale quotes are below your paid cost. You give up upside for immediate cash. Return displayed pieces to trading and withdraw live listings first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toptan alım teklifleri ödediğin maliyetin altındadır. Anında nakit için olası kazançtan vazgeçersin. Önce sergilenen parçaları ticarete geri al ve aktif ilanları geri çek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großhandelsangebote liegen unter deinen bezahlten Kosten. Du verzichtest auf mögliche Gewinne für sofortiges Bargeld. Gib Sammlungsstücke zuerst frei und ziehe aktive Angebote zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les offres de gros sont inférieures à tes coûts. Tu renonces à un gain possible contre de l'argent immédiat. Libère d'abord les objets exposés et retire les annonces actives."
          }
        }
      }
    },
