    },
    "market.empty": {
      "comment": "Empty market placeholder before listings are available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next discovery starts here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni keşiflerin burada başlıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier beginnt deine nächste Entdeckung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prochaine trouvaille commence ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo descubrimiento empieza aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima scoperta inizia qui."
          }
        }
      }
    },
    "messages.title": {
      "comment": "Negotiation conversations tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar"
          }
        },
        "de": {
