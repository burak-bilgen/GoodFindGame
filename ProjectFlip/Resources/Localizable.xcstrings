        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcının bilgisi eksik olabilir. İnceleme daha fazlasını ortaya çıkarabilir."
          }
        }
      }
    },
    "listing.description": {
      "comment": "Listing/seller context: listing.description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the seller"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcının açıklaması"
          }
        }
      }
    },
    "listing.description.careful": {
      "comment": "Listing/seller context: listing.description.careful.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used regularly. Happy to answer questions before you decide."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli kullandım. Karar vermeden önce aklına takılanları sorabilirsin."
          }
        }
      }
    },
    "listing.description.uncertain": {
      "comment": "Listing/seller context: listing.description.uncertain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing out some old gear. I don’t know much about this one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evdeki eski eşyaları elden çıkarıyorum. Bu üründen pek anlamıyorum."
          }
        }
      }
    },
    "listing.description.evasive": {
      "comment": "Listing/seller context: listing.description.evasive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks great. Priced to move, so please keep questions brief."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüsü gayet iyi. Fiyatı uygun tuttum, çok soru sormadan alacak olan yazsın."
          }
        }
      }
    },
