        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vente n'a pas couvert ta mise. Prévois plus d'écart entre le prix d'achat et le prix de revente espéré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La venta no cubrió lo que invertiste. Deja más espacio entre la compra y la reventa esperada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vendita non ha coperto l'investimento. Lascia più spazio tra prezzo d'acquisto e rivendita prevista."
          }
        }
      }
    },
    "result.lesson.win": {
