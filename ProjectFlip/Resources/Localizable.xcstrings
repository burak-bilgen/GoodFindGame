    "clients.filterCaution": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model matches only. Condition, faults and required parts still need inspection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca model eşleşir. Kondisyon, kusurlar ve gereken parçalar hâlâ incelenmeli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Modell passt. Zustand, Mängel und erforderliche Teile müssen noch geprüft werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le modèle correspond. L’état, les défauts et les pièces requises restent à vérifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo coincide el modelo. Aún hay que inspeccionar el estado, los fallos y las piezas requeridas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde solo il modello. Condizioni, guasti e componenti richiesti vanno ancora verificati."
          }
        }
      }
    },
