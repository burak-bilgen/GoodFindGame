    "shop.openingStory": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one window spot. Choose what you sell and who you want to attract. Opening and expansion use your trading cash; there is no rent while you are away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir vitrin yeriyle başla. Ne satacağına, kimi çekeceğine karar ver. Açılış ve büyüme al-sat sermayenden karşılanır; oyunda değilken kira birikmez."
          }
        }
      }
    },
