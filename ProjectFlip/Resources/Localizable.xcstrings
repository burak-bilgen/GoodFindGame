      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest first"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en yeniler"
          }
        },
        "de": {
