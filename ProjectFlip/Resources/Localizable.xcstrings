    "repair.plan.total": {
      "comment": "Optional selective repair planner for an owned inspected item. Uses only known faults, normal immediate repair fees and uncertain resale estimates. No guaranteed buyer, cosmetic restoration or extra reward.",
      "extractionState": "manual",
      "localizations": {
        "en": {
