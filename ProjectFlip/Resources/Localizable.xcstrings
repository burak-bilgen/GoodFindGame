    "living.audience.furniture": {
      "comment": "Everyday second-hand goods. Original fictional brands; genuine product-specific risks, never a country economy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furniture buyers look at condition and value; interest is not guaranteed."
