    "recovery.limit": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only below %@ cash, with no trading stock or deliveries left. Fees stop at that cash floor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca nakdin %@ altındayken, stokta ürünün veya bekleyen teslimatın yoksa kullanılabilir. Ücretler bu nakit eşiğinde durur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur unter %@ Bargeld, ohne Handelsbestand oder ausstehende Lieferungen. Die Gebühren enden an dieser Bargeldgrenze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement sous %@, sans stock à vendre ni livraison en cours. Les rémunérations s'arrêtent à ce seuil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con menos de %@, sin existencias ni entregas pendientes. Los honorarios cesan al alcanzar ese mínimo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con meno di %@, senza scorte o consegne in arrivo. I compensi si fermano a quella soglia."
          }
        }
      }
    },
