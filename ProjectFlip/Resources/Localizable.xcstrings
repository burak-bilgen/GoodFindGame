    "client.mira.story.0": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am opening a little breakfast corner. Find a dependable appliance without the price of brand-new equipment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir kahvaltı köşesi açıyorum. Sıfır ürün parası harcamadan güvenilir bir mutfak aleti bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich eröffne eine kleine Frühstücksecke. Finde ein zuverlässiges Gerät, ohne den Neupreis zu zahlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ouvre un petit coin petit-déjeuner. Trouve un appareil fiable sans payer le prix du neuf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy a abrir un rincón de desayunos. Busca un aparato fiable sin pagar lo que cuesta uno nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto aprendo un piccolo angolo colazioni. Cerca un apparecchio affidabile senza il prezzo del nuovo."
          }
        }
      }
    },
    "client.mira.story.1": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That first find earned its place. Mornings are busier now; I need another kitchen workhorse, checked properly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk buluntu yerini hak etti. Sabahlar artık daha yoğun; iyice kontrol edilmiş, iş görecek bir mutfak aleti daha lazım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Fund hat sich bewährt. Morgens ist mehr los; ich brauche einen weiteren gründlich geprüften Küchenhelfer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première trouvaille a fait ses preuves. Les matins sont plus chargés ; il me faut un autre appareil de cuisine bien vérifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer hallazgo se ha ganado su sitio. Las mañanas están más animadas; necesito otro aparato de cocina bien revisado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo acquisto si è meritato il posto. Le mattine sono più intense: mi serve un altro aiutante in cucina, controllato bene."
          }
        }
      }
    },
    "client.mira.story.2": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The counter is ready for a signature coffee. Find a machine in exceptional condition; every morning will depend on it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezgâh, bize özgü bir kahveye hazır. Çok iyi durumda bir makine bul; her sabah ona güveneceğiz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Theke ist bereit für unseren besonderen Kaffee. Finde eine Maschine in herausragendem Zustand, auf die wir uns jeden Morgen verlassen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptoir est prêt pour notre café signature. Trouve une machine en excellent état : chaque matin en dépendra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra ya está lista para nuestro café especial. Busca una máquina en estado excepcional; cada mañana dependerá de ella."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bancone è pronto per il nostro caffè speciale. Cerca una macchina in condizioni eccezionali: ogni mattina dipenderà da lei."
          }
        }
      }
    },
    "client.mira.ending": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A corner of the neighborhood runs on your finds now. When something needs replacing, you are my first call."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık mahallenin bir köşesi senin buluntularınla işliyor. Bir şey değişecekse ilk seni ararım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stück Nachbarschaft läuft jetzt mit deinen Funden. Wenn etwas ersetzt werden muss, rufe ich zuerst dich an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coin du quartier tourne grâce à tes trouvailles. Quand il faudra remplacer quelque chose, je t’appellerai en premier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rincón del barrio funciona con tus hallazgos. Cuando toque sustituir algo, te llamaré primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un angolo del quartiere funziona grazie ai tuoi ritrovamenti. Quando servirà sostituire qualcosa, chiamerò prima te."
          }
        }
      }
    },
