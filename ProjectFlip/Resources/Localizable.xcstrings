    "buyer.hold": {
      "comment": "Buyer holds an existing public offer; no private budget is revealed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am staying at this price. That is my final offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fiyatta kalıyorum. Son teklifim bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe bei diesem Preis. Das ist mein letztes Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reste sur ce prix. C'est ma dernière offre."
          }
        }
      }
    },
    "region.title": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency & language"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi ve dil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währung & Sprache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devise et langue"
          }
        }
      }
    },
    "region.fixed": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One marketplace for every language. Currency changes how prices are displayed; it never changes value, supply or difficulty. Language follows your iPhone’s app language setting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dilde aynı pazar. Para birimi yalnızca fiyatların gösterimini değiştirir; değeri, ürün arzını veya zorluğu etkilemez. Oyun dili iPhone’daki uygulama dili ayarını izler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Markt für alle Sprachen. Die Währung ändert nur die Preisanzeige, nie Wert, Angebot oder Schwierigkeit. Die Sprache folgt der App-Sprache deines iPhones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul marché pour toutes les langues. La devise change l'affichage des prix, jamais la valeur, l'offre ou la difficulté. La langue suit le réglage de l'app sur ton iPhone."
          }
        }
      }
    },
    "region.currency": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display currency"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterim para birimi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigewährung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devise affichée"
          }
        }
      }
    },
    "region.fx": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline game rates: 1 USD = 40 TRY. These are fictional balance settings, not live exchange rates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı oyun kuru: 1 USD = 40 TRY. Bunlar oyun dengesi değerleridir, güncel döviz kuru değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Spielkurs: 1 USD = 40 TRY. Fiktive Spieleinstellungen, keine aktuellen Wechselkurse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux du jeu hors ligne : 1 USD = 40 TRY. Ce sont des paramètres fictifs, pas des taux de change réels."
          }
        }
      }
    },
    "region.migrationTitle": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Economy updated"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekonomi güncellendi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirtschaft aktualisiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économie mise à jour"
          }
        }
      }
    },
    "region.migration": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy credits were rebased at 20:1 into canonical value. Cash, costs and outstanding quotes were converted together. Product valuations now use believable price bands. Your original save was backed up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski krediler 20:1 oranında temel değere dönüştürüldü. Nakit, maliyetler ve bekleyen teklifler birlikte çevrildi. Ürün değerleri artık gerçekçi fiyat aralıklarını kullanıyor. Önceki kaydın yedeklendi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Guthaben wurden im Verhältnis 20:1 in den einheitlichen Wert umgerechnet. Bargeld, Kosten und offene Angebote wurden gemeinsam angepasst. Produktwerte nutzen jetzt plausible Preisspannen. Dein ursprünglicher Spielstand wurde gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens crédits ont été convertis à 20:1 en valeur commune. Argent, coûts et offres en cours ont été convertis ensemble. Les objets utilisent désormais des fourchettes de prix plausibles. Ta sauvegarde d'origine a été conservée."
          }
        }
      }
    },
