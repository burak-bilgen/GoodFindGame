    "knowledge.clues.gaming": {
      "comment": "Gaming inspection guide; does not assert that this item has any defect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen for fan noise and check ports. Diagnosing drift, heat or battery wear needs practice and tools. Storage and wireless faults take more experience."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan sesini dinle, bağlantı noktalarına bak. Analog kaymasını, ısınmayı ve pil aşınmasını saptamak için deneyim ve araç gerekir. Depolama ve kablosuz bağlantı arızalarını anlamak daha fazla bilgi ister."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf Lüftergeräusche und Anschlüsse. Drift, Hitze und Akkuverschleiß erfordern Übung und Werkzeug. Speicher- und Funkfehler brauchen mehr Erfahrung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute le ventilateur et vérifie les ports. Le drift, la surchauffe et l'usure de la batterie demandent de la pratique et des outils. Les pannes de stockage et de connexion exigent plus d'expérience."
          }
        }
      }
    },
    "knowledge.clues.cameras": {
      "comment": "Camera inspection guide; does not reveal actual hidden defects.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with lens scratches. Battery tests need practice; autofocus and shutter wear need deeper knowledge. Sensor, fungus and stabilization checks need expert knowledge and tools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce lens çiziklerine bak. Pil testi deneyim, otomatik odaklama ve perde aşınması daha fazla bilgi gerektirir. Sensör, mantar ve sabitleme kontrolü için uzman bilgisi ve araç gerekir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit Kratzern auf dem Objektiv. Akkutests brauchen Übung; Autofokus und Verschlussverschleiß mehr Wissen. Sensor, Pilzbefall und Stabilisierung erfordern Expertenwissen und Werkzeug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par les rayures de l'objectif. Les tests de batterie demandent de la pratique ; l'autofocus et l'obturateur, davantage de connaissances. Le capteur, les champignons et la stabilisation nécessitent une expertise et des outils."
          }
        }
      }
    },
    "knowledge.clues.retro": {
      "comment": "Retro inspection guide; not a statement of actual item authenticity.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the box, labels, manual and missing pieces first. Replacement parts need closer testing. Region checks need experience; counterfeit boards need expert knowledge and tools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce kutuyu, etiketleri, kılavuzu ve eksik parçaları kontrol et. Değişmiş parçalar daha ayrıntılı test ister. Bölge kontrolü deneyim, sahte devre kartını tanımak ise uzman bilgisi ve araç gerektirir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe zuerst Verpackung, Etiketten, Anleitung und fehlende Teile. Ersatzteile brauchen genauere Tests. Regionalversionen erfordern Erfahrung, gefälschte Platinen Expertenwissen und Werkzeug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie d'abord la boîte, les étiquettes, la notice et les pièces manquantes. Les pièces remplacées demandent des tests poussés. Les régions exigent de l'expérience ; les circuits contrefaits, une expertise et des outils."
          }
        }
      }
    },
    "knowledge.tools.gaming": {
      "comment": "Explains permanent electronics diagnostic kit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electronics kit: controller tester, load tester and port probes. A permanent purchase for this category; knowledge is still required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektronik seti: kontrolcü ve yük test cihazı, bağlantı probları. Bu kategori için kalıcıdır; bilgi gereksinimini kaldırmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektronik-Set: Controller-Tester, Lastprüfer und Anschlussprüfer. Einmaliger Kauf für diese Kategorie; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit électronique : testeur de manette, testeur de charge et sondes de ports. Achat définitif pour cette catégorie ; les connaissances restent nécessaires."
          }
        }
      }
    },
    "knowledge.tools.cameras": {
      "comment": "Explains permanent camera diagnostic kit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera kit: test chart, sensor light and battery tester. A permanent purchase for this category; knowledge is still required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf seti: test kartı, sensör ışığı ve pil test cihazı. Bu kategori için kalıcıdır; bilgi gereksinimini kaldırmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera-Set: Testbild, Sensorleuchte und Akkutester. Einmaliger Kauf für diese Kategorie; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit photo : mire, éclairage du capteur et testeur de batterie. Achat définitif pour cette catégorie ; les connaissances restent nécessaires."
          }
        }
      }
    },
    "knowledge.tools.retro": {
      "comment": "Explains permanent collectible diagnostic kit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collector kit: magnifier, board probes and region tester. A permanent purchase for this category; knowledge is still required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyoncu seti: büyüteç, devre probları ve bölge test cihazı. Bu kategori için kalıcıdır; bilgi gereksinimini kaldırmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammler-Set: Lupe, Platinenprüfer und Regionaltester. Einmaliger Kauf für diese Kategorie; Fachwissen bleibt nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit collection : loupe, sondes de circuit et testeur de région. Achat définitif pour cette catégorie ; les connaissances restent nécessaires."
          }
        }
      }
    },
