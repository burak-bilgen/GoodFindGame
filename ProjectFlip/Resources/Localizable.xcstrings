    "client.aya.story.0": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am furnishing a small reading corner. Find one solid, useful piece with character, not a showroom price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir okuma köşesi döşüyorum. Mağaza fiyatına değil; karakteri olan, sağlam ve işe yarar bir parça bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich richte eine kleine Leseecke ein. Finde ein solides, nützliches Stück mit Charakter, aber ohne Ausstellungsraumpreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’aménage un petit coin lecture. Trouve une pièce solide et utile, avec du caractère mais sans le prix du neuf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy amueblando un rincón de lectura. Busca una pieza sólida, útil y con carácter, sin precio de exposición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto arredando un piccolo angolo lettura. Cerca un pezzo solido e utile, con carattere ma senza il prezzo da esposizione."
          }
        }
      }
    },
    "client.aya.story.1": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reading corner feels like home now. Next is a working corner: practical furniture, good surfaces, no structural surprises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma köşesi artık ev gibi hissettiriyor. Sırada çalışma köşesi var: kullanışlı mobilya, düzgün yüzeyler, sağlam yapı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leseecke fühlt sich jetzt heimisch an. Als Nächstes kommt eine Arbeitsecke: praktische Möbel, gute Oberflächen, keine bösen Überraschungen am Gestell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coin lecture est devenu accueillant. Passons à l’espace de travail : un meuble pratique, de bonnes surfaces et une structure sans surprise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rincón ya se siente como un hogar. Ahora toca trabajar: muebles prácticos, buenas superficies y sin sorpresas estructurales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’angolo lettura ora sa di casa. Tocca alla zona lavoro: mobili pratici, buone superfici e nessuna sorpresa nella struttura."
          }
        }
      }
    },
    "client.aya.story.2": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My next client wants a favorite seat, not just another chair. Find exceptional condition and a frame I can trust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki müşterim sıradan bir sandalye değil, en sevdiği oturma yerini istiyor. Çok iyi kondisyon ve güvenilir bir iskelet bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein nächster Kunde sucht einen Lieblingsplatz, nicht bloß einen Stuhl. Finde hervorragenden Zustand und ein verlässliches Gestell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon prochain client cherche son siège préféré, pas une chaise de plus. Trouve un état remarquable et une structure fiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi próximo cliente quiere su asiento favorito, no otra silla más. Busca un estado excepcional y una estructura fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo cliente vuole la sua seduta preferita, non una sedia qualsiasi. Cerca condizioni eccezionali e una struttura affidabile."
          }
        }
      }
    },
    "client.aya.ending": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rooms have their own character now. You have become the person I ask when a space needs the right second-hand piece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odalar artık kendi karakterine sahip. Bir mekâna doğru ikinci el parça gerektiğinde başvuracağım kişi sensin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Räume haben jetzt ihren eigenen Charakter. Wenn ich das passende gebrauchte Stück brauche, frage ich dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces pièces ont maintenant leur caractère. Quand il me faudra le bon meuble d’occasion, je penserai à toi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios ya tienen personalidad. Eres a quien recurro cuando hace falta la pieza de segunda mano adecuada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ambienti ora hanno carattere. Sei la persona a cui mi rivolgo quando serve il giusto pezzo di seconda mano."
          }
        }
      }
    },
