    "region.sharedMigration": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your career now uses the shared market. Your cash, items, costs and existing quotes are unchanged. New listings use the same pricing rules for everyone. Your previous save was backed up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kariyerin artık ortak pazarı kullanıyor. Nakdin, ürünlerin, maliyetlerin ve mevcut tekliflerin korundu. Yeni ilanlarda herkes için aynı fiyat kuralları geçerli. Önceki kaydın yedeklendi."
          }
        }
      }
    },
