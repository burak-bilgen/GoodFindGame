    "trend.reason.seasonalDemand": {
      "comment": "Reason for a positive category-wide demand trend.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seasonal interest is bringing more buyers to this category."
          }
        },
        "tr": {
