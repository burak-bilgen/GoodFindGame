    "knowledge.reinspect": {
      "comment": "Free inspection after improved category capability; awards no extra experience.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recheck with new skills / tools"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bilgi ve araçlarla tekrar incele"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit neuem Wissen oder Werkzeug prüfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réexaminer avec tes nouveaux moyens"
          }
        }
      }
    },
    "knowledge.inspectionLimit": {
      "comment": "Limits on free inspection; no claim that unrevealed faults exist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-inspection can miss faults. New knowledge or tools let you recheck for free; an expert report is more thorough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz incelemede bazı kusurlar gözden kaçabilir. Bilgin arttığında veya araç aldığında ücretsiz tekrar bakabilirsin. Uzman raporu daha kapsamlıdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Eigenprüfung können Fehler unentdeckt bleiben. Neues Wissen oder Werkzeug ermöglicht eine kostenlose Nachprüfung; ein Expertenbericht ist gründlicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une inspection personnelle peut manquer des défauts. De nouvelles connaissances ou de nouveaux outils permettent un réexamen gratuit ; un rapport d'expert est plus approfondi."
          }
        }
      }
    },
    "facts.title": {
      "comment": "Owned-item measurements and category evidence screen title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection findings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme bulguları"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfergebnisse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats de l'inspection"
          }
        }
      }
    },
    "facts.explanation": {
      "comment": "Explains unknown measurements and ways to reveal them without claiming a fault exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These findings belong to this physical item. A locked field has not been checked; it does not mean the item passed. Improve your category knowledge and tools, then recheck, or order an expert report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bulgular elindeki ürüne aittir. Kilitli alan henüz kontrol edilmemiştir; ürünün sorunsuz olduğu anlamına gelmez. Kategori bilgini ve araçlarını geliştirip tekrar incele veya uzman raporu iste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ergebnisse gehören zu diesem konkreten Artikel. Ein gesperrtes Feld wurde nicht geprüft und bedeutet nicht, dass alles in Ordnung ist. Verbessere Wissen und Werkzeug, prüfe erneut oder beauftrage einen Experten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces résultats concernent cet objet précis. Un champ verrouillé n'a pas été vérifié : cela ne signifie pas que le test est réussi. Améliore tes connaissances et tes outils, puis réexamine l'objet ou demande un rapport d'expert."
          }
        }
      }
    },
    "facts.notChecked": {
      "comment": "Unknown fact value, never a healthy result.",
      "extractionState": "manual",
