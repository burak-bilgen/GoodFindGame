    "shop.style.collector.detail": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a retro window. More collectors, but a slower audience. Condition and price still decide the deal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrinini retro ürünlerle kur. Koleksiyoncular daha çok gelir, ama daha seyrek uğrar. Son sözü yine ürünün durumu ve fiyatı söyler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalte ein Retro-Schaufenster. Mehr Sammler, aber ein langsameres Publikum. Zustand und Preis entscheiden weiterhin über das Geschäft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une vitrine rétro. Davantage de collectionneurs, mais un public plus lent à se décider. L'état et le prix restent décisifs."
          }
        }
      }
    },
