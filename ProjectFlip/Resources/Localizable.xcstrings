    "recovery.liquidationWarning": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wholesale quotes are below your paid cost. You give up upside for immediate cash. Withdraw live listings before liquidating their stock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toptan alım fiyatı ödediğin bedelin altındadır. Anında nakit karşılığında olası kazançtan vazgeçersin. Ürünü tasfiye etmeden önce aktif ilanını geri çek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großhandelspreise liegen unter deinen Kosten. Du verzichtest für sofortiges Bargeld auf mögliche Gewinne. Ziehe aktive Inserate vor der Liquidation zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix de gros est inférieur à ton coût d’achat. Tu renonces à un gain potentiel contre de l’argent immédiat. Retire l’annonce active avant de liquider l’objet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio mayorista es inferior a lo que pagaste. Renuncias a una posible ganancia a cambio de dinero inmediato. Retira primero los anuncios activos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo all’ingrosso è inferiore al costo pagato. Rinunci a un possibile guadagno in cambio di denaro immediato. Ritira prima gli annunci attivi."
          }
        }
      }
    },
    "recovery.liquidate": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
