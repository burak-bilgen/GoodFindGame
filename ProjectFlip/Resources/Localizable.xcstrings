        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilya alıcısı duruma ve değere bakar; ilgi garanti değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möbelkäufer achten auf Zustand und Wert; Interesse ist nicht garantiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les acheteurs de meubles regardent l'état et la valeur ; l'intérêt n'est pas garanti."
          }
        }
