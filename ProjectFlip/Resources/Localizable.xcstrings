            "value": "Your game saves on this device. Trading and weekly challenges work offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun bu cihazda kaydedilir. Ticaret ve haftalık mücadele çevrimdışı çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Spiel wird auf diesem Gerät gespeichert. Handel und Wochenherausforderungen funktionieren offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta partie reste sur cet appareil. Les échanges et défis hebdomadaires fonctionnent hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida se guarda en este dispositivo. El comercio y los retos semanales funcionan sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La partita si salva su questo dispositivo. Gli affari e le sfide settimanali funzionano offline."
          }
        }
      }
