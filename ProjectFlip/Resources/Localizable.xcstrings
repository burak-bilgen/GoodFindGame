    "seller.trades %lld": {
      "comment": "Number of prior NPC marketplace trades. The integer is localized by SwiftUI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld completed trade"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld completed trades"
                }
              }
            }
          }
        },
