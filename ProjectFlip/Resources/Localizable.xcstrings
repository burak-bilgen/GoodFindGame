    "competition.localOnly": {
      "comment": "Offline launch: no account is needed for local weekly results and achievements.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly results and achievements are saved on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık sonuçlar ve başarımlar bu cihazda saklanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenergebnisse und Erfolge werden auf diesem Gerät gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats hebdomadaires et les succès sont conservés sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados semanales y los logros se guardan en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risultati settimanali e obiettivi vengono salvati su questo dispositivo."
          }
        }
      }
    },
    "privacy.support": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you email support, the developer receives the address and information you choose to include. Your email provider handles delivery. Do not send passwords, payment details or other sensitive information. The game does not automatically attach your save or gameplay data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğe e-posta gönderirsen geliştirici, adresini ve paylaşmayı seçtiğin bilgileri alır. İletimi e-posta sağlayıcın yönetir. Şifre, ödeme bilgisi veya başka hassas bilgiler gönderme. Oyun, kaydını ya da oyun verilerini otomatik olarak eklemez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Support per E-Mail kontaktierst, erhält der Entwickler deine Adresse und die Informationen, die du teilst. Dein E-Mail-Anbieter übernimmt die Zustellung. Sende keine Passwörter, Zahlungsdaten oder anderen sensiblen Informationen. Das Spiel hängt weder Spielstand noch Spieldaten automatisch an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu contactes l’assistance par e-mail, le développeur reçoit ton adresse et les informations que tu choisis de partager. Ton fournisseur de messagerie gère l’envoi. N’envoie ni mot de passe, ni données de paiement, ni autre information sensible. Le jeu ne joint pas automatiquement ta sauvegarde ou tes données de jeu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si escribes al soporte por correo, el desarrollador recibe tu dirección y la información que decidas incluir. Tu proveedor de correo gestiona la entrega. No envíes contraseñas, datos de pago ni otra información sensible. El juego no adjunta automáticamente tu partida ni tus datos de juego."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scrivi all'assistenza, lo sviluppatore riceve il tuo indirizzo e le informazioni che scegli di includere. Il tuo provider di posta gestisce l'invio. Non inviare password, dati di pagamento o altre informazioni sensibili. Il gioco non allega automaticamente il salvataggio o i dati di gioco."
          }
        }
      },
      "comment": "Privacy policy: voluntary support email is separate from automatic game data collection.",
      "extractionState": "manual"
    },
