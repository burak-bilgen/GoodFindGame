    "recovery.notEligible": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery job is needed now. Resolve incoming or held trading stock first. Active listings can be withdrawn from Selling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kurtarma işi gerekmiyor. Önce gelecek ürünleri veya ticaret stokunu değerlendir. Aktif ilanları Satışlar ekranından geri çekebilirsin."
          }
        }
      }
    },
