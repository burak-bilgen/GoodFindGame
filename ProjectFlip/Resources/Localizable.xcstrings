    "competition.fairness": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone starts with $1,000 of value, the same market and fresh expertise. Display currency changes the numbers you see, not your buying power. Your career wealth stays in your career."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes 1.000 $ değerinde sermaye, aynı pazar ve sıfır uzmanlıkla başlar. Gösterim para birimi yalnızca gördüğün rakamları değiştirir, alım gücünü değil. Kariyer birikimin kariyerinde kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle starten mit einem Gegenwert von 1.000 USD, demselben Markt und ohne Fachwissen. Die Anzeigewährung ändert nur die Zahlen, nicht deine Kaufkraft. Dein Karrierevermögen bleibt in deiner Karriere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde commence avec une valeur de 1 000 USD, le même marché et sans expertise. La devise affichée change les chiffres, pas ton pouvoir d'achat. La fortune de ta carrière reste dans ta carrière."
          }
        }
      }
    },
