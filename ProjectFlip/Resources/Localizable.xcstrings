    "trade.explanation": {
      "comment": "Financial ledger: trade.explanation. Realized results count completed sales only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net result = sale proceeds − acquisition − inspection − repairs. Condition, asking price and the buyer’s valuation affect the sale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net sonuç = satış tutarı − alış maliyeti − inceleme − onarım. Kondisyon, ilan fiyatı ve alıcının biçtiği değer satış tutarını etkiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoergebnis = Erlös − Kaufpreis − Prüfkosten − Reparaturen. Zustand, Angebotspreis und die Einschätzung des Käufers beeinflussen den Verkauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultat net = vente − achat − inspection − réparations. L’état, le prix demandé et l’estimation de l’acheteur influencent la vente."
          }
        }
      }
    },
