    "profile.intro": {
      "comment": "Trader profile introductory flavor copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deal tells a story. Make yours count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alışverişin bir hikâyesi var. Seninkini yaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Handel erzählt eine Geschichte. Mach deine besonders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque affaire a son histoire. À toi d’écrire la tienne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trato cuenta una historia. Haz que la tuya importe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni affare racconta una storia. Dai valore alla tua."
          }
        }
      }
    },
    "market.heading": {
      "comment": "Market shell: market.heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the overlooked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözden kaçanı keşfet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke, was andere übersehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère ce que les autres ont manqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra lo que otros no ven."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova ciò che gli altri non vedono."
          }
        }
      }
    },
    "market.subtitle": {
      "comment": "Market shell: market.subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look closer. Ask questions. Make your move."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkatli bak. Soru sor. Fırsatı değerlendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau genauer hin. Frag nach. Entscheide selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe. Pose des questions. À toi de jouer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira de cerca. Haz preguntas. Decide tu jugada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda meglio. Fai domande. Scegli la tua mossa."
          }
        }
      }
    },
