    "collection.chapter.story": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the brass direction disc to the color era: three experiments in how people played. Keep their lineage together."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirinç yön diskinden renkli ekran çağına: oyun oynamanın üç farklı yorumu. Bu ürün ailesini bir arada tut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Messing-Steuerscheibe bis zur Farbära: drei Experimente des Spielens. Bewahre ihre gemeinsame Geschichte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du disque de commande en laiton à l'ère de la couleur : trois façons d'explorer le jeu. Réunis leur histoire."
          }
        }
      }
    },
