        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisonales Interesse bringt mehr Käufer in diese Kategorie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regain d’intérêt saisonnier attire davantage d’acheteurs dans cette catégorie."
          }
