    "shop.style.bargains.detail": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer at or below your inspected estimate. Faster interest, but bargain hunters and resellers protect their margins."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme tahmininin üzerinde fiyat isteme. İlgi daha hızlı gelir; pazarlıkçılar ve al-satçılar kendi kârını da düşünür."
          }
        }
      }
    },
    "shop.style.tested": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tested & trusted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollü, güvenilir ürünler"
          }
        }
      }
    },
    "shop.style.tested.detail": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature fully inspected goods with no known unresolved faults. Pay for the evidence; attract cautious customers. Their budgets stay their own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekspertizli, bilinen arızası giderilmiş ürünleri sergile. İncelemeye yatırım yap; temkinli müşterilere hitap et. Bütçelerini yine onlar belirler."
          }
        }
      }
    },
    "shop.style.collector": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
