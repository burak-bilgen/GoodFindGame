    "region.fixed": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your market is saved with this career. Language and display currency never change its prices. Start a separate career to use a different market."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazarın bu kariyere bağlıdır. Dil ve gösterim para birimi pazar fiyatlarını değiştirmez. Farklı bir pazar için ayrı kariyer gerekir."
          }
        }
      }
    },
