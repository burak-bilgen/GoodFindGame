    "listing.description.careful": {
      "comment": "Listing/seller context: listing.description.careful.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used regularly. Happy to answer questions before you decide."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli kullandım. Karar vermeden önce aklına takılanları sorabilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmäßig benutzt. Ich beantworte gern Fragen, bevor du dich entscheidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé régulièrement. Je réponds volontiers à tes questions avant que tu te décides."
          }
        }
      }
    },
    "listing.description.uncertain": {
      "comment": "Listing/seller context: listing.description.uncertain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing out some old gear. I don’t know much about this one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evdeki eski eşyaları elden çıkarıyorum. Bu üründen pek anlamıyorum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich räume alte Sachen aus. Damit kenne ich mich nicht besonders aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais du tri dans mon vieux matériel. Je ne connais pas très bien cet objet."
          }
        }
      }
    },
    "listing.description.evasive": {
      "comment": "Listing/seller context: listing.description.evasive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks great. Priced to move, so please keep questions brief."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüsü gayet iyi. Fiyatı uygun tuttum, çok soru sormadan alacak olan yazsın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht super aus. Günstig abzugeben, also bitte nicht zu viele Fragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il présente très bien. À ce prix-là, merci d’aller à l’essentiel."
          }
        }
      }
    },
