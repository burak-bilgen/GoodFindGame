          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce prix, je le prends. Sinon, je continue à chercher."
          }
        }
      }
    },
    "living.replyPending": {
      "comment": "Buyer counter reply is actually queued; the amount displayed is the existing prior offer, not a new response.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for buyer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcıdan yanıt bekleniyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf den Käufer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l'acheteur"
          }
        }
      }
    },
    "living.previousOffer": {
      "comment": "Buyer counter reply is actually queued; the amount displayed is the existing prior offer, not a new response.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous offer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki teklif"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorheriges Angebot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre précédente"
          }
        }
      }
    },
    "error.replyWindowTooShort": {
      "comment": "A live offer remains acceptable, but not enough listing time remains for the delayed buyer counter reply. Do not say the deal is already closed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough time for a counter reply. You can still accept the current offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşı teklif yanıtı için yeterli süre kalmadı. Mevcut teklifi hâlâ kabul edebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Gegenantwort bleibt nicht genug Zeit. Du kannst das aktuelle Angebot noch annehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste pas assez de temps pour une réponse. Tu peux encore accepter l'offre actuelle."
          }
        }
      }
    },
    "living.watchedSold": {
      "comment": "Genuine watched marketplace closure; do not forecast while a firm quote defers it or another earlier closure invalidates it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another trader bought the %1$@ you were watching."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediğin %1$@ ürününü başka bir tüccar aldı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Händler hat %1$@ von deiner Merkliste gekauft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre marchand a acheté %1$@ que tu suivais."
          }
        }
      }
    },
    "living.watchedExpired": {
      "comment": "Genuine watched marketplace closure; do not forecast while a firm quote defers it or another earlier closure invalidates it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watched listing for %1$@ expired."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediğin %1$@ ilanı sona erdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gemerkte Angebot für %1$@ ist abgelaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annonce suivie pour %1$@ a expiré."
          }
        }
      }
    },
