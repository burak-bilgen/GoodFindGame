    "selling.priceUnchanged": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is already your asking price. Your existing offers and buyer search stay unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, mevcut ilan fiyatın. Açık teklifler ve alıcı araması değişmeden kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist bereits dein Verkaufspreis. Offene Angebote und die Käufersuche bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est déjà ton prix demandé. Les offres ouvertes et la recherche d’acheteurs restent inchangées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ya es el precio del anuncio. Las ofertas abiertas y la búsqueda de compradores no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già il prezzo richiesto. Le offerte aperte e la ricerca di acquirenti restano invariate."
          }
        }
      }
    },
    "selling.currentAsking": {
      "comment": "Player sale repricing: a real edit withdraws current offers/counter replies and resamples buyer search, preserving expiry and earned traffic. Equal numeric price is a no-op. No hidden budget or promised buyer.",
