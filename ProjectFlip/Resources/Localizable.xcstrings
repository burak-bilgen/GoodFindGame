    "selling.empty": {
      "comment": "Empty resale listing screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active sales. Inspect an item in Inventory to list it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif satış yok. İlan vermek için Envanter’de bir ürünü incele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktiven Verkäufe. Prüfe einen Artikel im Inventar, um ihn anzubieten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vente active. Examine un objet du stock pour le mettre en vente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ventas activas. Inspecciona un artículo en Inventario para anunciarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna vendita attiva. Ispeziona un oggetto nell'Inventario per metterlo in vendita."
          }
        }
      }
    },
    "profile.title": {
      "comment": "Player profile tab.",
