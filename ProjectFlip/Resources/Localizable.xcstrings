    "buyer.pushRisk": {
      "comment": "Existing buyer negotiation and waiting presentation. Describe only the visible offer/reply; do not imply guaranteed interest or reveal a hidden buyer budget.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modest counter can get a better or firm offer. A large jump may end the conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makul bir karşı teklif fiyatı iyileştirebilir; alıcı fiyatında da kalabilir. Büyük bir artış görüşmeyi bitirebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein maßvolles Gegenangebot kann ein besseres oder festes Angebot bringen. Ein großer Sprung kann das Gespräch beenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une contre-offre modérée peut améliorer l'offre ou confirmer son dernier prix. Une forte hausse peut mettre fin à l'échange."
          }
        }
      }
    },
    "buyer.pushAgainRisk": {
      "comment": "Existing buyer negotiation and waiting presentation. Describe only the visible offer/reply; do not imply guaranteed interest or reveal a hidden buyer budget.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is their final offer. Accept it or pass; asking for more ends the conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, alıcının son teklifi. Kabul et ya da geç; daha fazlasını istemek görüşmeyi bitirir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das letzte Angebot. Annehmen oder ablehnen; mehr zu fordern beendet das Gespräch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est sa dernière offre. Accepte ou refuse ; demander davantage met fin à l'échange."
          }
        }
      }
    },
    "buyer.counterCommitment": {
      "comment": "Existing buyer negotiation and waiting presentation. Describe only the visible offer/reply; do not imply guaranteed interest or reveal a hidden buyer budget.",
      "extractionState": "manual",
      "localizations": {
        "en": {
