    "buyer.offer.cautious.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to leave some room for a surprise repair. Here is my offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenmedik bir tamir için biraz pay bırakmak istiyorum. Teklifim bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich möchte etwas Spielraum für eine unerwartete Reparatur lassen. Das ist mein Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je préfère garder une marge pour une réparation imprévue. Voici mon offre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiero dejar margen para una reparación imprevista. Esta es mi oferta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisco lasciare un margine per una riparazione imprevista. Ecco la mia offerta."
          }
        }
      }
    },
    "buyer.offer.cautious.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I like it, but I need to be careful with this purchase. Would you take this?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoşuma gitti ama bu alışverişte temkinli olmalıyım. Bu fiyata verir misin?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gefällt mir, aber ich muss bei diesem Kauf vorsichtig sein. Wäre dieser Preis in Ordnung?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça me plaît, mais je dois rester prudent pour cet achat. Ce prix vous conviendrait ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me gusta, pero debo ir con cuidado con esta compra. ¿Aceptarías este precio?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi piace, ma devo essere prudente con questo acquisto. Accetteresti questa cifra?"
          }
        }
      }
    },
    "buyer.offer.bargainHunter.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have been comparing listings. This is the price I would buy at."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlanları karşılaştırıyorum. Bu fiyata alırım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Angebote verglichen. Zu diesem Preis würde ich kaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai comparé les annonces. À ce prix, je serais intéressé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He estado comparando anuncios. Por este precio lo compraría."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto confrontando gli annunci. A questo prezzo lo comprerei."
          }
        }
      }
    },
    "buyer.offer.bargainHunter.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good deal matters to me. Can we agree on this price?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benim için uygun fiyat önemli. Bu fiyatta anlaşabilir miyiz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist ein guter Preis wichtig. Können wir uns darauf einigen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je cherche une bonne affaire. On peut se mettre d’accord sur ce prix ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busco una buena oferta. ¿Podemos acordar este precio?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerco un buon affare. Possiamo accordarci su questa cifra?"
          }
        }
      }
    },
    "buyer.offer.collector.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the kind of item I have been looking for. Here is my offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aradığım türden bir ürün. Teklifim bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach so einem Stück habe ich gesucht. Das ist mein Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le genre d’objet que je cherchais. Voici mon offre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el tipo de artículo que buscaba. Esta es mi oferta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tipo di oggetto che cercavo. Ecco la mia offerta."
          }
        }
      }
    },
    "buyer.offer.collector.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It would fit nicely in my collection. Would this work for you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyonuma güzel gider. Bu fiyat sana uyar mı?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das würde gut in meine Sammlung passen. Wäre dieser Preis für dich in Ordnung?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça irait bien dans ma collection. Ce prix vous conviendrait ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encajaría bien en mi colección. ¿Te parece bien este precio?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Starebbe bene nella mia collezione. Questa cifra ti andrebbe bene?"
          }
        }
      }
    },
    "buyer.offer.impatient.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would rather settle this quickly. Here is my offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu hızlıca halletmek isterim. Teklifim bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich würde das gern zügig abschließen. Das ist mein Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’aimerais conclure rapidement. Voici mon offre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiero cerrar el trato pronto. Esta es mi oferta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferirei concludere in fretta. Ecco la mia offerta."
          }
        }
      }
    },
    "buyer.offer.impatient.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the price works, I am ready to buy. How about this?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat uyarsa almaya hazırım. Buna ne dersin?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Preis passt, bin ich zum Kauf bereit. Wie wäre es damit?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le prix me convient, je suis prêt à acheter. Que dites-vous de cette offre ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el precio encaja, puedo comprarlo. ¿Qué te parece esta oferta?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il prezzo va bene, posso comprarlo. Che ne dici di questa offerta?"
          }
        }
      }
    },
    "buyer.offer.reseller.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need room for my own costs and margin. This is my offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi masraflarım ve kârım için pay bırakmalıyım. Teklifim bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche Spielraum für meine Kosten und Marge. Das ist mein Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dois garder une marge pour mes frais et mon bénéfice. Voici mon offre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesito margen para mis gastos y mi beneficio. Esta es mi oferta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devo lasciare un margine per i miei costi e il guadagno. Ecco la mia offerta."
          }
        }
      }
    },
    "buyer.offer.reseller.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a resale purchase, this is the price that makes sense to me."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden satmak için alıyorum; bana göre uygun fiyat bu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Weiterverkauf ist dieser Einkaufspreis für mich sinnvoll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un achat destiné à la revente, ce prix me paraît raisonnable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una compra destinada a la reventa, este precio me encaja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un acquisto destinato alla rivendita, questo prezzo mi sembra adatto."
          }
        }
      }
    },
    "buyer.offer.lowballer.1": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know it is below your asking price, but would you consider this?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin fiyatın altında, biliyorum. Yine de düşünür müsün?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich weiß, das liegt unter deinem Preis. Würdest du es trotzdem in Betracht ziehen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sais que c’est sous votre prix, mais vous y réfléchiriez ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé que es menos de lo que pides, pero ¿lo considerarías?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "So che è meno di quanto chiedi, ma lo prenderesti in considerazione?"
          }
        }
      }
    },
    "buyer.offer.lowballer.2": {
      "comment": "Opening dialogue from a fictional simulated buyer. Expresses preferences only; does not reveal private budget or promise a deadline. Stable variant chosen independently of pricing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am trying my luck with a low offer. Any chance?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şansımı düşük bir teklifle deniyorum. Oluru var mı?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich versuche mein Glück mit einem niedrigen Angebot. Besteht eine Chance?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tente ma chance avec une petite offre. Ce serait possible ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebo suerte con una oferta baja. ¿Hay alguna posibilidad?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento la fortuna con un’offerta bassa. C’è qualche possibilità?"
          }
        }
      }
    },
    "clients.noModels": {
      "comment": "Client model-filter empty state. Existing search/category/price filters also apply. No promise that matching stock will spawn or that a matching model has acceptable condition. Pausing a request is free and preserves progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching models right now"
          }
        },
        "tr": {
