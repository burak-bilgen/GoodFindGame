    "competition.scoreRules": {
      "comment": "Competition V1: optional social play, isolated weekly economy and gameplay achievement copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score v1: net realized profit relative to the starting bankroll, portfolio return, and a capped bonus for inspected profitable trades across different models. Losses reduce profit. Repeated models earn no extra quality bonus. Maximum: 1,000,000."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan v1: başlangıç sermayesine göre gerçekleşen net kâr, toplam yatırım getirisi ve farklı modellerdeki incelenmiş kârlı satışlar için sınırlı ek puan. Zararlar kârdan düşer. Aynı modeli tekrar satmak ek kalite puanı kazandırmaz. Üst sınır: 1.000.000."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkte v1: realisierter Nettogewinn im Verhältnis zum Startkapital, Gesamtrendite und ein begrenzter Bonus für geprüfte, gewinnbringende Verkäufe verschiedener Modelle. Verluste senken den Gewinn. Wiederholte Modelle bringen keinen weiteren Qualitätsbonus. Maximum: 1.000.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Score v1 : bénéfice net réalisé rapporté au capital initial, rendement global et bonus plafonné pour les ventes bénéficiaires de modèles différents inspectés. Les pertes réduisent le bénéfice. Répéter un modèle n'ajoute pas de bonus de qualité. Maximum : 1 000 000."
          }
        }
      }
    },
