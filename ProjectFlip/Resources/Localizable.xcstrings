    "clients.itemBusy": {
      "comment": "Recurring client expansion: preserve model names, requirement meanings and all format placeholders. Informal second-person voice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw its live listing or let the booked report finish before supplying it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teslim etmek için aktif ilanı geri çek veya bekleyen raporun bitmesini bekle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe das aktive Inserat zurück oder warte auf den gebuchten Bericht, bevor du lieferst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire l’annonce active ou attends la fin du rapport en cours avant de livrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira el anuncio activo o espera a que termine el informe pendiente antes de entregar."
          }
        },
        "it": {
