    "listing.voice.casual.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making some room at home. I can take a closer look if there is a detail you want checked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde biraz yer açıyorum. Kontrol etmemi istediğin bir ayrıntı varsa yakından bakabilirim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich mache zu Hause etwas Platz. Wenn dich ein Detail interessiert, kann ich genauer hinsehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais un peu de place chez moi. Si un détail t'intéresse, je peux y regarder de plus près."
          }
        }
      }
    },
    "listing.voice.casual.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has been sitting in the spare room. I would rather someone used it than keep moving it out of the way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş odada durup duruyor. Sürekli yerini değiştireceğime kullanacak birine gitsin istedim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es stand die ganze Zeit im Gästezimmer. Lieber nutzt es jemand, als dass ich es ständig zur Seite räume."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traîne dans la chambre d'amis. Je préfère qu'il serve à quelqu'un plutôt que de le déplacer sans arrêt."
          }
        }
      }
    },
    "listing.voice.casual.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are changing things around at home, so this is going. Have a look and ask before deciding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde biraz değişiklik yapıyoruz, bu da satılacaklar arasında. Karar vermeden bak, aklına takılanı sor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir richten uns zu Hause neu ein, deshalb darf es weiterziehen. Schau es dir an und frag, bevor du dich entscheidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On change un peu l'aménagement, alors je m'en sépare. Regarde et pose tes questions avant de décider."
          }
        }
      }
    },
    "listing.voice.clueless.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helping a relative clear some things out. I have not checked every detail, so please ask rather than assume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yakınımın eşyalarını elden çıkarmasına yardım ediyorum. Her ayrıntısını kontrol etmedim; varsaymak yerine sor lütfen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich helfe einem Verwandten beim Ausräumen. Ich habe nicht jedes Detail geprüft, also frag lieber nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'aide un proche à faire du tri. Je n'ai pas tout vérifié, alors mieux vaut poser des questions."
          }
        }
      }
    },
    "listing.voice.clueless.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know what it is, but I am not the person to ask about the technical bits. Tell me which detail matters to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olduğunu biliyorum ama teknik kısmından pek anlamam. Senin için hangi ayrıntının önemli olduğunu söyle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich weiß, was es ist, aber für technische Details bin ich nicht die richtige Person. Sag mir, was dir wichtig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sais ce que c'est, mais la technique, ce n'est pas mon domaine. Dis-moi quel détail compte pour toi."
          }
        }
      }
    },
    "listing.voice.clueless.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found this while sorting the house. I cannot give a detailed condition report; the price reflects that uncertainty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evi toparlarken çıktı. Ayrıntılı durum raporu verecek bilgim yok; fiyatı da o belirsizliği düşünerek koydum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aufräumen gefunden. Einen ausführlichen Zustandsbericht kann ich nicht geben; der Preis berücksichtigt diese Unsicherheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvé en rangeant la maison. Je ne peux pas fournir un bilan détaillé ; le prix tient compte de cette incertitude."
          }
        }
      }
    },
    "listing.voice.urgent.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving this week. Collection soon matters more to me than a long back-and-forth over the last few notes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta taşınıyorum. Son birkaç kuruş için günlerce yazışmaktansa çabuk alınması daha önemli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ziehe diese Woche um. Eine schnelle Abholung ist mir wichtiger als langes Feilschen um die letzten Scheine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je déménage cette semaine. Un départ rapide compte plus pour moi que de longues négociations pour quelques billets."
          }
        }
      }
    },
    "listing.voice.urgent.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need the space back. If you are seriously interested, send a clear offer and we can sort it out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapladığı yere ihtiyacım var. Ciddi düşünüyorsan net bir teklif gönder, konuşalım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche den Platz. Bei ernsthaftem Interesse schick ein klares Angebot, dann werden wir uns einig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai besoin de récupérer la place. Si tu es vraiment intéressé, fais une offre claire et on s'arrange."
          }
        }
      }
    },
    "listing.voice.urgent.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the last things left to clear. I would like a straightforward sale, not days of reserved promises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elden çıkarılacak son eşyalardan biri. Günlerce ayırmamı istemektense net bir satış olsun istiyorum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines der letzten Dinge, die noch wegmüssen. Ich möchte einen unkomplizierten Verkauf, keine tagelangen Reservierungsversprechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'une des dernières choses à faire partir. Je veux une vente simple, pas des promesses de réservation qui durent des jours."
          }
        }
      }
    },
    "listing.voice.professional.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available from my current stock. Please specify which detail you want checked; I prefer clear questions to guesses."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut stoktan satılıktır. Hangi ayrıntıyı kontrol etmemi istediğini belirt; tahmin yürütmektense net sorularla ilerleyelim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus meinem aktuellen Bestand. Sag bitte genau, welches Detail ich prüfen soll; klare Fragen sind besser als Vermutungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible dans mon stock actuel. Précise ce que tu veux faire vérifier ; je préfère les questions claires aux suppositions."
          }
        }
      }
    },
    "listing.voice.professional.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The asking price is for this exact example. Condition, included parts and a clear agreement matter more than the headline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlan fiyatı bu ürün içindir. Başlıktan çok durumu, yanında verilen parçalar ve net bir anlaşma önemlidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis gilt für genau dieses Exemplar. Zustand, Zubehör und klare Absprachen zählen mehr als die Überschrift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix concerne cet exemplaire précis. L'état, les pièces fournies et un accord clair comptent plus que le titre de l'annonce."
          }
        }
      }
    },
    "listing.voice.professional.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I handle these regularly. Ask about the condition before offering so we do not talk past each other."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tür eşyalarla düzenli ilgileniyorum. Tekliften önce durumunu sorarsan birbirimizi yanlış anlamayız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich handle regelmäßig damit. Frag vor deinem Angebot nach dem Zustand, damit wir nicht aneinander vorbeireden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'en vends régulièrement. Renseigne-toi sur l'état avant de proposer un prix, pour qu'on se comprenne bien."
          }
        }
      }
    },
    "listing.voice.stubborn.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am in no hurry. If the price does not work for you, that is fine, but please do not open with half of it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelem yok. Fiyat sana uymayabilir, sorun değil; ama yarısını teklif ederek başlamayalım lütfen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe es nicht eilig. Wenn der Preis nicht passt, ist das okay. Aber bitte nicht gleich mit der Hälfte anfangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne suis pas pressé. Si le prix ne te convient pas, aucun souci, mais évite de commencer à la moitié."
          }
        }
      }
    },
    "listing.voice.stubborn.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed at the price I am willing to discuss. Comparing it with an unseen bargain elsewhere will not help much."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmaya değer bulduğum fiyattan koydum. Başka yerde görmediğimiz bir fırsatla kıyaslamak pek yardımcı olmuyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über den angegebenen Preis kann man reden. Ein angebliches Schnäppchen anderswo ist kein gutes Argument."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix affiché se discute. Le comparer à une affaire introuvable ailleurs ne fera pas beaucoup avancer les choses."
          }
        }
      }
    },
    "listing.voice.stubborn.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still available. Sensible questions are welcome; I am not looking to get rid of it at any price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ satılık. Mantıklı sorulara açığım; yeter ki gitsin diye her fiyata bırakmayı düşünmüyorum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch verfügbar. Vernünftige Fragen sind willkommen, aber ich gebe es nicht um jeden Preis ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours disponible. Les questions sérieuses sont bienvenues, mais je ne m'en débarrasse pas à n'importe quel prix."
          }
        }
      }
    },
    "listing.voice.friendly.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would like this to go to someone who has a use for it. Happy to talk through the details."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşine yarayacak birine gitsin istiyorum. Ayrıntılarını birlikte konuşabiliriz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es soll zu jemandem, der etwas damit anfangen kann. Über die Einzelheiten rede ich gern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'aimerais qu'il aille à quelqu'un qui en a l'usage. Je réponds volontiers aux questions."
          }
        }
      }
    },
    "listing.voice.friendly.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rush to decide from one photo. Tell me what you need to know and I will answer what I can."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek fotoğraftan hemen karar vermek zorunda değilsin. Merak ettiğini söyle, bildiğim kadarıyla cevaplayayım."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide nicht nur nach einem Foto. Sag mir, was du wissen möchtest, und ich antworte, soweit ich kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas besoin de décider sur une seule photo. Dis-moi ce que tu veux savoir, je répondrai de mon mieux."
          }
        }
      }
    },
    "listing.voice.friendly.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit of a clear-out, not a shop. Be fair with me and I will be fair with you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dükkân değil, evden birkaç eşya satıyorum. Karşılıklı makul davranırsak anlaşırız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich räume nur etwas auf, ich bin kein Laden. Wenn du fair bist, bin ich es auch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais juste du tri, je ne suis pas une boutique. Sois correct avec moi, je le serai avec toi."
          }
        }
      }
    },
    "listing.voice.manipulative.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks the part. There has been interest, so I would rather keep this quick than go through a long checklist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duruşu yerinde. İlgilenenler var; uzun kontrol listelerine girmeden hızlıca halletsek iyi olur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht einen guten Eindruck. Es gibt schon Interesse, also lieber kurz und knapp statt langer Prüflisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il présente bien. J'ai déjà des intéressés, alors je préfère aller vite plutôt que parcourir une longue liste de vérifications."
          }
        }
      }
    },
    "listing.voice.manipulative.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priced to get your attention. The photos should tell you enough for a first offer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat çeksin diye bu fiyattan koydum. İlk teklif için fotoğraflar yeterince fikir veriyordur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis soll auffallen. Die Fotos sollten für ein erstes Angebot reichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prix fait pour attirer l'attention. Les photos devraient suffire pour une première offre."
          }
        }
      }
    },
    "listing.voice.manipulative.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good-looking find for somebody. I cannot hold it while every tiny mark gets discussed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinin hoşuna gidecek bir parça. Her küçük izi konuşurken günlerce ayıramam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hübscher Fund für jemanden. Ich kann es nicht reservieren, während jede kleine Spur besprochen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une jolie trouvaille pour quelqu'un. Je ne peux pas le réserver pendant qu'on discute de chaque petite marque."
          }
        }
      }
    },
    "listing.voice.collector.0": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have a reason for keeping things, and a reason for letting them go. This one is ready for a new owner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşyaları saklamamın da elden çıkarmamın da bir nedeni var. Bu artık yeni sahibine gitmeye hazır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Gründe, Dinge zu behalten, und Gründe, sie weiterzugeben. Dieses Stück ist bereit für einen neuen Besitzer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai mes raisons de garder les choses et mes raisons de les céder. Celle-ci est prête pour un nouveau propriétaire."
          }
        }
      }
    },
    "listing.voice.collector.1": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small details matter to me. Ask about what is actually here; I will not invent a story to make it sound rare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük ayrıntıları önemserim. Eşyanın kendisini sor; nadirmiş gibi göstermek için hikâye uydurmam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleinen Details sind mir wichtig. Frag nach dem, was wirklich da ist. Ich erfinde keine Geschichte, um es selten wirken zu lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petits détails comptent pour moi. Demande ce qui est réellement présent ; je n'inventerai pas une histoire pour le faire paraître rare."
          }
        }
      }
    },
    "listing.voice.collector.2": {
      "comment": "Complete authored marketplace seller voice. Vary length, phrasing and motivation; no added mechanical fact or guaranteed condition. Kept stable per listing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More interested in a thoughtful buyer than the fastest message. We can talk about the details before the price."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En hızlı mesajdan çok ne aldığını bilen biri ilgimi çeker. Fiyattan önce ayrıntıları konuşabiliriz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist ein aufmerksamer Käufer lieber als die schnellste Nachricht. Über Details können wir vor dem Preis reden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je préfère un acheteur attentif au message le plus rapide. On peut parler des détails avant du prix."
          }
        }
      }
    },
