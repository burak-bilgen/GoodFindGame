    "client.rowan.story.0": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want a handheld I can actually enjoy. Find a checked, clean example—not a sealed trophy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekten oynayabileceğim bir el konsolu istiyorum. Kapalı kutu bir gösteriş ürünü değil, incelenmiş temiz bir örnek bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich suche einen Handheld, mit dem ich wirklich spielen kann. Finde ein geprüftes, sauberes Exemplar, keine versiegelte Trophäe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux une console portable dont je puisse vraiment profiter. Trouve un exemplaire propre et vérifié, pas un trophée sous blister."
          }
        }
      }
    },
    "client.rowan.story.1": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That first find earned its place. Now I want the original box too; the little details tell its story."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk bulduğun ürün yerini hak etti. Şimdi orijinal kutusunu da istiyorum; küçük ayrıntılar onun hikâyesini anlatıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Fund hat seinen Platz verdient. Jetzt möchte ich auch die Originalverpackung; die kleinen Details erzählen seine Geschichte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première trouvaille a gagné sa place. Cette fois, je veux aussi la boîte d'origine : les petits détails racontent son histoire."
          }
        }
      }
    },
    "client.rowan.story.2": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know what I collect now. Find an exceptional original Chapter example for the centerpiece. No invented rarity—just the right piece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık ne topladığımı biliyorsun. Koleksiyonun merkezi için çok temiz, özgün bir Chapter bul. Uydurma nadirlik değil, doğru parça."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kennst meine Sammlung inzwischen. Finde ein außergewöhnliches Original von Chapter als Herzstück. Keine erfundene Seltenheit, einfach das richtige Stück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu connais maintenant ma collection. Trouve un exemplaire original exceptionnel de Chapter pour en faire la pièce maîtresse. Pas de rareté inventée, juste la bonne pièce."
          }
        }
      }
    },
    "client.jules.story.0": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My backup camera needs replacing. Find an inspected body with plenty of life left."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek fotoğraf makinemi değiştirmem gerekiyor. İncelenmiş, hâlâ iyi durumda bir gövde bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ersatzkamera muss ersetzt werden. Finde ein geprüftes Gehäuse, das noch lange hält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dois remplacer mon appareil de secours. Trouve un boîtier inspecté qui a encore de beaux jours devant lui."
          }
        }
      }
    },
    "client.jules.story.1": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera worked out. This time I need clean optics; a good deal means nothing if the glass is wrong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine işimi gördü. Bu kez temiz optik lazım; camda sorun varsa iyi fiyatın anlamı kalmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat sich bewährt. Jetzt brauche ich saubere Optik; ein Schnäppchen bringt nichts, wenn das Glas nicht stimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil a fait ses preuves. Cette fois, il me faut une optique impeccable : une bonne affaire ne vaut rien si le verre ne suit pas."
          }
        }
      }
    },
    "client.jules.story.2": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I trust your eye for equipment. Source a premium body for a demanding shoot, with a full report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipman konusundaki gözüne güveniyorum. Zorlu bir çekim için tam raporlu, üst düzey bir gövde bul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich vertraue deinem Blick für Ausrüstung. Besorge ein Premiumgehäuse für einen anspruchsvollen Auftrag, mit vollständigem Bericht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai confiance en ton jugement. Trouve un boîtier haut de gamme pour une séance exigeante, avec un rapport complet."
          }
        }
      }
    },
    "client.rowan.ending": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You helped build a collection with a history. Collector’s confidant is now part of your story."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişi olan bir koleksiyon kurmama yardım ettin. Artık bir koleksiyoncunun sırdaşısın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Sammlung mit Geschichte mit aufgebaut. Als Vertrauter eines Sammlers hast du dir einen Namen gemacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as aidé à bâtir une collection qui a une histoire. Tu es désormais une personne de confiance pour les collectionneurs."
          }
        }
      }
    },
    "client.jules.ending": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You became the dealer I call before an important job. That is worth more than one good sale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli bir iş öncesinde aradığım satıcı oldun. Bunun değeri tek bir iyi satıştan büyük."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der Händler geworden, den ich vor einem wichtigen Auftrag anrufe. Das ist mehr wert als ein einzelner guter Verkauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es devenu le marchand que j'appelle avant une mission importante. Ça vaut plus qu'une seule bonne vente."
          }
        }
      }
    },
    "collections.title": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
