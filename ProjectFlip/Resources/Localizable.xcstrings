    "notebook.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your completed trades by category. Past gains do not guarantee the next sale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorilere göre gerçekleşmiş sonuçların. Geçmiş kazanç, yeni satışın garantisi değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine abgeschlossenen Geschäfte nach Kategorie. Frühere Gewinne garantieren keinen neuen Verkauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes ventes terminées par catégorie. Les gains passés ne garantissent pas la prochaine vente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus operaciones terminadas por categoría. Las ganancias pasadas no garantizan la próxima venta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi scambi conclusi per categoria. I guadagni passati non garantiscono la prossima vendita."
          }
        }
      },
      "comment": "Personal trade notebook derived from settled normal sales and client handoffs. No forecasts. Counts are profitable/loss/break-even trade totals, in that order."
    },
