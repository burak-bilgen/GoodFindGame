    "knowledge.endorsement": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After rank 3: study 6 different models and diagnose 3 fault types for specialist recognition and more confident estimates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. seviyeden sonra: uzmanlık onayı ve daha güvenli tahminler için 6 farklı model incele, 3 kusur türünü tanı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Stufe 3: Untersuche 6 verschiedene Modelle und diagnostiziere 3 Fehlertypen für fachliche Anerkennung und genauere Schätzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le niveau 3 : étudie 6 modèles différents et diagnostique 3 types de défauts pour être reconnu et affiner tes estimations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el nivel 3: estudia 6 modelos distintos y diagnostica 3 tipos de fallo para obtener reconocimiento como especialista y estimaciones más fiables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il livello 3: studia 6 modelli diversi e diagnostica 3 tipi di guasto per ottenere il riconoscimento da specialista e stime più affidabili."
          }
        }
      }
    },
