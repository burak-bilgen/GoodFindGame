    "shop.intro": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a place worth coming back to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müşterinin yeniden gelmek isteyeceği bir yer kur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue einen Laden auf, zu dem man gern zurückkommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un endroit où l'on aime revenir."
          }
        }
      }
    },
    "shop.openingStory": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one window spot. Choose what you sell and who you want to attract. Opening and expansion use your trading cash; there is no rent while you are away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir vitrin yeriyle başla. Ne satacağına, kimi çekeceğine karar ver. Açılış ve büyüme al-sat sermayenden karşılanır; oyunda değilken kira birikmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einem Schaufensterplatz. Wähle deine Waren und dein Publikum. Eröffnung und Ausbau kosten Handelskapital; während deiner Abwesenheit fällt keine Miete an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec une place en vitrine. Choisis tes objets et le public que tu veux attirer. L'ouverture et l'agrandissement utilisent ton capital ; aucun loyer ne court en ton absence."
          }
        }
      }
    },
    "shop.name": {
      "comment": "Player-owned shop: finite window space, real capital investment, distinct customer audiences. No automatic profits.",
