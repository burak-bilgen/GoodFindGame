    "tradeRead.claim": {
      "comment": "Pre-purchase appraisal based only on public seller claims and disclosed faults; never a guarantee of profit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the claimed condition. Faults are still unverified."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beyan edilen kondisyona göre. Kusurlar henüz doğrulanmadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgehend vom angegebenen Zustand. Mängel sind noch ungeprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon l’état annoncé. Les défauts restent à vérifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en el estado declarado. Los fallos siguen sin verificar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alle condizioni dichiarate. I guasti non sono ancora verificati."
          }
        }
      }
    },
    "tradeRead.disclosed": {
      "comment": "Pre-purchase appraisal based only on public seller claims and disclosed faults; never a guarantee of profit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes the issues this seller disclosed. Other faults may remain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcının açıkladığı kusurlar dahil. Başka kusurlar olabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berücksichtigt die genannten Mängel. Weitere sind möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient compte des défauts signalés. D’autres peuvent subsister."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye los problemas que ha declarado el vendedor. Puede haber otros fallos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include i problemi dichiarati dal venditore. Potrebbero esserci altri guasti."
          }
        }
      }
    },
    "tradeRead.caution": {
      "comment": "Pre-purchase appraisal based only on public seller claims and disclosed faults; never a guarantee of profit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyers can offer less. Leave room for surprises, inspection and repairs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcılar daha az önerebilir. Sürprizler, inceleme ve onarım için pay bırak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufer können weniger bieten. Plane Spielraum für Überraschungen, Prüfung und Reparaturen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les acheteurs peuvent proposer moins. Prévois une marge pour les imprévus, l’expertise et les réparations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los compradores pueden ofrecer menos. Deja margen para sorpresas, inspección y reparaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquirenti possono offrire meno. Lascia margine per sorprese, ispezione e riparazioni."
          }
        }
      }
    },
