    },
    "region.title": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency & language"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi ve dil"
          }
        }
      }
    },
    "region.fixed": {
      "comment": "Shared fictional marketplace. Language changes presentation only; stable identity indices and economic outcomes remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One marketplace for every language. Currency changes how prices are displayed; it never changes value, supply or difficulty. Language follows your iPhone’s app language setting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dilde aynı pazar. Para birimi yalnızca fiyatların gösterimini değiştirir; değeri, ürün arzını veya zorluğu etkilemez. Oyun dili iPhone’daki uygulama dili ayarını izler."
          }
        }
      }
    },
    "region.currency": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display currency"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterim para birimi"
          }
        }
      }
    },
    "region.fx": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline game rates: 1 USD = 40 TRY. These are fictional balance settings, not live exchange rates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı oyun kuru: 1 USD = 40 TRY. Bunlar oyun dengesi değerleridir, güncel döviz kuru değildir."
          }
        }
      }
    },
    "region.migrationTitle": {
      "comment": "Market configuration and explicit economy migration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
