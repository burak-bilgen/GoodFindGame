    "clients.principle": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two buyers. A shared history. Hunt at your own pace; requests have no offline expiry. One accepted request at a time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki alıcı. Ortak bir geçmiş. Kendi hızında ara; talepler çevrimdışıyken sona ermez. Aynı anda bir talep kabul edebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Käufer. Eine gemeinsame Geschichte. Suche in deinem Tempo; Aufträge laufen offline nicht ab. Nur ein angenommener Auftrag gleichzeitig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux acheteurs. Une histoire commune. Cherche à ton rythme : les demandes n'expirent pas hors ligne. Une seule demande acceptée à la fois."
          }
        }
      }
    },
    "clients.condition": {
      "comment": "Trading career milestone; player-facing progression and market-world copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
