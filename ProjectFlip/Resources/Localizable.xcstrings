    "listing.claimWarning": {
      "comment": "Listing/seller context: listing.claimWarning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seller claims may be incomplete. Inspection can reveal more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcının bilgisi eksik olabilir. İnceleme daha fazlasını ortaya çıkarabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkäuferangaben können unvollständig sein. Eine Prüfung kann mehr zeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indications du vendeur peuvent être incomplètes. Une inspection peut en révéler davantage."
          }
        }
      }
    },
    "listing.description": {
      "comment": "Listing/seller context: listing.description.",
