          "stringUnit": {
            "state": "translated",
            "value": "La valeur ajoutée pourrait couvrir la réparation et dégager plus de marge."
          }
        }
      }
    },
    "repair.marginNegative": {
      "comment": "Repair decision: compares estimated value recovered minus service cost with selling as-is. This is not total trade profit or a guaranteed sale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repair may cost more than the value it adds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onarım, katacağı değerden daha pahalıya gelebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reparatur könnte mehr kosten, als sie an Wert bringt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réparation pourrait coûter plus que la valeur qu'elle ajoute."
          }
        }
      }
    },
    "repair.marginEven": {
